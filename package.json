{
  "name": "triss-coworker",
  "version": "0.37.1",
  "description": "Give your AI coding agent a cheap DeepSeek coworker. Delegate bulk reads, boilerplate, and doc updates to save 60-70% of your token budget.",
  "type": "module",
  "bin": {
    "triss": "bin/triss.js"
  },
  "workspaces": [
    "packages/dsh-provider-bundle"
  ],
  "files": [
    "bin/",
    "src/",
    "templates/",
    "docs/configuration.md",
    "docs/mcp.md",
    "docs/usage-accounting.md",
    "docs/getting-started.md",
    "docs/cli-reference.md",
    "docs/security-model.md",
    "docs/reliable-delegation-contract.md",
    "docs/data-flows.md",
    "docs/compatibility.md",
    "docs/deprecations.md",
    "docs/troubleshooting.md",
    "docs/integrations/",
    "docs/engines/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "test": "node scripts/check-lockfile-gate.cjs && npm run test:secure-default && npm run test:best-effort",
    "test:secure-default": "node scripts/run-tests.js secure-default",
    "test:best-effort": "TRISS_CODER_ALLOW_BEST_EFFORT_ISOLATION=1 node --test test/best-effort-*.test.js",
    "start": "node bin/triss.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "node scripts/check-js-syntax.js",
    "docs:defaults": "node scripts/generate-config-defaults.js",
    "check:config-docs": "node scripts/generate-config-defaults.js --check",
    "check:docs": "npm run check:config-docs && node scripts/check-doc-links.js",
    "check:package": "node scripts/check-package-contents.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:docs && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "mcp",
    "model-context-protocol",
    "deepseek",
    "openrouter",
    "ollama",
    "llm",
    "agent",
    "coworker",
    "delegation",
    "ai",
    "cli",
    "developer-tools",
    "code-review",
    "token-saving",
    "jira",
    "linear",
    "confluence"
  ],
  "author": "ayleen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayleen/triss-coworker.git"
  },
  "bugs": {
    "url": "https://github.com/ayleen/triss-coworker/issues"
  },
  "homepage": "https://github.com/ayleen/triss-coworker#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "linkedom": "^0.18.12",
    "openai": "^7.4.0",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0"
  }
}
