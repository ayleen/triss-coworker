{
  "name": "triss-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Triss project website (Astro + Cloudflare Pages)",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "test:lighthouse": "node scripts/check-lighthouse.mjs",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "astro": "^7.2.4",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "lighthouse": "^13.4.1",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.5.0"
  }
}
