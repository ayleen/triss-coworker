interface Command {
  name: string;
  tier: string;
  group: string;
  body: string;
  flags: string[];
  example: string;
}

interface Props { command: Command; }
const { command } = Astro.props;
const tierColor = command.tier === "main"
  ? "#e0a458"
  : command.tier === "small"
    ? "var(--color-accent)"
    : "var(--color-text-muted)";
---
<div style="background: var(--color-bg-raised); padding: 22px;">
  <div data-agent-meta style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
    <span style="font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--color-text-heading);">triss {command.name}</span>
    <span style={`font-family: var(--font-mono); font-size: 11px; padding: 4px 8px; border: 1px solid var(--color-border-strong); color: ${tierColor};`}>{command.tier}</span>
    <span style="font-family: var(--font-mono); font-size: 11px; color: var(--color-text-label);">{command.group}</span>
  </div>
  <p style="margin: 10px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--color-text-secondary);">{command.body}</p>
  <div data-agent-flags style="margin-top: 12px; display: flex; gap: 6px; flex-wrap: wrap;">
    {command.flags.map((flag) => <span style="font-family: var(--font-mono); font-size: 11.5px; background: var(--color-bg-code); border: 1px solid var(--color-border-subtle); padding: 4px 8px; color: var(--color-text-muted);">{flag}</span>)}
  </div>
  <pre style="margin: 12px 0 0; background: #08090b; border: 1px solid var(--color-border-subtle); padding: 12px; font-family: var(--font-mono); font-size: 12px; white-space: pre-wrap; color: var(--color-accent);">{command.example}</pre>
</div>
