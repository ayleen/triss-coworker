import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Base title="Quickstart — Triss" description="From nothing to a delegated call in five steps. Node ≥22, one API key, five copy-paste steps.">
  <Header current="quickstart" />

  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 72px var(--layout-gutter) 44px; border-bottom: 1px solid var(--color-border);">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">quickstart</div>
    <h1 style="margin: 0; font-size: 52px; line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--color-text-strong); max-width: 22em;">From nothing to a delegated call in five steps.</h1>
    <p style="margin: 22px 0 0; max-width: 42em; font-size: 17px; line-height: 1.65; color: var(--color-text-secondary);">You need Node.js ≥ 22.12 and one API key. The wizard does the rest.</p>
    <div style="display: flex; align-items: center; gap: 16px; margin-top: 34px; max-width: 520px;">
      <div style="flex: 1; height: 3px; background: var(--color-border); position: relative; overflow: hidden;">
        <div id="progress-bar" style="height: 3px; background: var(--color-accent); width: 0%;"></div>
      </div>
      <span id="progress-label" style="font-family: var(--font-mono); font-size: 12px; color: var(--color-text-faint); white-space: nowrap;">0 / 5 done</span>
    </div>
  </section>

  <div class="quickstart-layout" style="max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-gutter); display: grid; grid-template-columns: 220px 1fr; gap: 56px; align-items: start;">
    <aside class="quickstart-steps" aria-label="Quickstart steps" style="position: sticky; top: 92px; padding: 56px 0; display: flex; flex-direction: column; gap: 2px;">
      <a href="#step-1" style="display: flex; gap: 12px; padding: 9px 10px; font-size: 13.5px; color: var(--color-text-secondary);"> <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label); padding-top: 2px;">01</span> Check Node </a>
      <a href="#step-2" style="display: flex; gap: 12px; padding: 9px 10px; font-size: 13.5px; color: var(--color-text-secondary);"> <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">02</span> Install the CLI </a>
      <a href="#step-3" style="display: flex; gap: 12px; padding: 9px 10px; font-size: 13.5px; color: var(--color-text-secondary);"> <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">03</span> Run the wizard </a>
      <a href="#step-4" style="display: flex; gap: 12px; padding: 9px 10px; font-size: 13.5px; color: var(--color-text-secondary);"> <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">04</span> Introduce to agent </a>
      <a href="#step-5" style="display: flex; gap: 12px; padding: 9px 10px; font-size: 13.5px; color: var(--color-text-secondary);"> <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">05</span> Delegate something </a>
    </aside>

    <main style="padding: 56px 0 40px; display: flex; flex-direction: column; gap: 64px; min-width: 0;">
      <section id="step-1">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
          <div> <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 14px;">step 01 · 20 seconds</div> <h2 style="margin: 0; font-size: 31px; line-height: 1.15; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Check Node</h2> </div>
          <button data-step="1" class="done-btn" style="flex-shrink: 0; font-family: var(--font-mono); font-size: 11.5px; padding: 8px 13px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-faint);">mark done</button>
        </div>
        <p style="margin: 14px 0 0; max-width: 44em; font-size: 15.5px; line-height: 1.7; color: var(--color-text-secondary);">Node 22.12 LTS or newer. Triss has no other runtime dependencies — seven direct packages, no build step.</p>
        <div style="margin-top: 22px; border: 1px solid var(--color-border-subtle); background: var(--color-bg-code); padding: 18px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.95;">
          <div style="color: var(--color-text-code);">$ node --version</div>
          <div style="color: var(--color-accent);">v22.14.0</div>
        </div>
      </section>

      <section id="step-2">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
          <div> <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 14px;">step 02 · 30 seconds</div> <h2 style="margin: 0; font-size: 31px; line-height: 1.15; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Install the CLI</h2> </div>
          <button data-step="2" class="done-btn" style="flex-shrink: 0; font-family: var(--font-mono); font-size: 11.5px; padding: 8px 13px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-faint);">mark done</button>
        </div>
        <div role="group" aria-label="Install method" style="display: flex; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); border-bottom: none; margin-top: 22px; flex-wrap: wrap;">
          <button data-pm="npm" aria-pressed="true" class="pm-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: #08090b; color: var(--color-accent);">npm</button>
          <button data-pm="pnpm" class="pm-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: var(--color-bg-raised); color: var(--color-text-muted);">pnpm</button>
          <button data-pm="yarn" class="pm-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: var(--color-bg-raised); color: var(--color-text-muted);">yarn</button>
          <button data-pm="curl" class="pm-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: var(--color-bg-raised); color: var(--color-text-muted);">curl</button>
        </div>
        <pre id="pm-code" style="margin: 0; border: 1px solid var(--color-border); background: #08090b; padding: 18px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.95; white-space: pre-wrap;"></pre>
      </section>

      <section id="upgrade-042" style="border: 1px solid #e0a458; background: var(--color-bg-raised); padding: 20px;">
        <div style="font-family: var(--font-mono); font-size: 12px; color: #e0a458;">Upgrading from Triss &lt; 0.42.0</div>
        <p style="margin: 10px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--color-text-secondary);">Triss 0.42 replaces worker configuration and model presets with unified provider profiles. After installing the update and before running model commands:</p>
        <pre style="margin: 12px 0 0; border: 1px solid var(--color-border); background: #08090b; padding: 14px 16px; font-family: var(--font-mono); font-size: 13px; line-height: 1.8; color: var(--color-text-code);">triss migrate
triss status</pre>
        <p style="margin: 10px 0 0; font-size: 13px; line-height: 1.65; color: var(--color-text-muted);">Restart MCP hosts and agent sessions after migration. Do not downgrade to a pre-0.42 release after migration.</p>
      </section>

      <section id="step-3">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
          <div> <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 14px;">step 03 · the only real step</div> <h2 style="margin: 0; font-size: 31px; line-height: 1.15; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Run the wizard</h2> </div>
          <button data-step="3" class="done-btn" style="flex-shrink: 0; font-family: var(--font-mono); font-size: 11.5px; padding: 8px 13px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-faint);">mark done</button>
        </div>
        <pre style="margin-top: 22px; border: 1px solid var(--color-border-subtle); background: #08090b; padding: 18px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.95; white-space: pre-wrap; color: var(--color-text-code);">$ triss config wizard

  Where to save?  [G]lobal ~/.config/triss/.env / [L]ocal ./.triss.env → G
  Default provider                                            → zai
  Default engine                                              → direct
  Z.A.I API key (masked)                                      → ••••••••
  Native model                                                → glm-5.2

✓ wrote ~/.config/triss/.env (chmod 600)
  Register MCP and write agent rules?                         → yes
  [C]laude / Code[X] / [B]oth                                 → B
✓ registered MCP server (claude + codex)
✓ wrote agent rules (CLAUDE.md + AGENTS.md)</pre>
        <div data-opencode2-quickstart style="margin-top: 22px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent);">Optional: use the OpenCode 2 beta engine</div>
          <pre style="margin: 8px 0 0; font-family: var(--font-mono); font-size: 12.5px; white-space: pre-wrap; color: var(--color-text-code);">$ npm install -g @opencode-ai/cli@beta
$ triss coder init --engine opencode2 --provider opencode-zen
$ triss coder run --engine opencode2 --model opencode-zen/deepseek-v4-flash-free "Implement the task"</pre>
          <p style="margin: 8px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--color-text-muted);">OpenCode 2 0.0.0-beta-19059 or newer is accepted by default. Triss never pins an exact build and checks required option declarations rather than help-description wording. Lower or malformed <code style="font-family: var(--font-mono);">TRISS_CODER_OPENCODE2_VERSION</code> values fall back to that floor.</p>
        </div>
        <div data-omp-quickstart style="margin-top: 22px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent);">Optional: use the native OMP coder engine</div>
          <pre style="margin: 8px 0 0; font-family: var(--font-mono); font-size: 12.5px; white-space: pre-wrap; color: var(--color-text-code);">$ curl https://omp.sh/install | sh
$ triss coder init --engine omp --provider opencode-go
$ triss coder run --engine omp --model opencode-go/deepseek-v4-flash "Create result.txt containing OMP_OK"</pre>
          <p style="margin: 8px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--color-text-muted);">OMP 18.0.6 or newer must already be installed; Triss only probes it and never runs the installer. OMP defaults to worktree isolation, but that is not host-filesystem confinement. Default credential mode is <code style="font-family: var(--font-mono);">best_effort_raw</code>; add <code style="font-family: var(--font-mono);">--protect-credentials</code> when the selected key must stay behind the parent-owned proxy.</p>
        </div>
        <div style="margin-top: 22px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent);">Optional: use OpenCode Go Muse for ask and review</div>
          <pre style="margin: 8px 0 0; font-family: var(--font-mono); font-size: 12.5px; white-space: pre-wrap; color: var(--color-text-code);">$ triss coder init --engine opencode --provider opencode-go

$ triss config set TRISS_DEFAULT_PROVIDER opencode-go
$ triss config set TRISS_DEFAULT_ENGINE opencode
$ triss config set TRISS_OPENCODE_GO_MODEL muse-spark-1.3-contributor
$ triss config set TRISS_OPENCODE_GO_SMALL_MODEL muse-spark-1.3-contributor
$ triss ask --paths 'src/**/*.js' --question "find correctness defects"
$ triss review</pre>
          <p style="margin: 8px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--color-text-muted);">Run <code style="font-family: var(--font-mono);">coder init</code> first: it verifies OpenCode, configures the key and provider, and writes the required engine configuration. Bare model-backed commands then inherit OpenCode Go and Muse. Every call installs and verifies a transient primary <code style="font-family: var(--font-mono);">triss-readonly-projection</code> agent that denies every tool by default and receives the complete request context in the prompt; it has no ambient file, shell, edit, skill, or delegation access. Pass a quoted glob such as <code style="font-family: var(--font-mono);">src/**/*.js</code> because directories are not read recursively. Explicit flags still win; add <code style="font-family: var(--font-mono);">--protect-credentials</code> when the key can stay behind the parent-owned proxy.</p>
        </div>
      </section>

      <section id="step-4">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
          <div> <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 14px;">step 04 · already done by Standard</div> <h2 style="margin: 0; font-size: 31px; line-height: 1.15; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Introduce it to your agent</h2> </div>
          <button data-step="4" class="done-btn" style="flex-shrink: 0; font-family: var(--font-mono); font-size: 11.5px; padding: 8px 13px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-faint);">mark done</button>
        </div>
        <div role="group" aria-label="Agent target" style="display: flex; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 22px; flex-wrap: wrap;">
          <button data-agent="claude" aria-pressed="true" class="agent-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: #08090b; color: var(--color-accent);">Claude Code</button>
          <button data-agent="codex" class="agent-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: var(--color-bg-raised); color: var(--color-text-muted);">Codex</button>
          <button data-agent="other" class="agent-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 11px 20px; cursor: pointer; border: none; background: var(--color-bg-raised); color: var(--color-text-muted);">Anything else</button>
        </div>
        <pre id="agent-code" style="margin: 0; border: 1px solid var(--color-border); background: #08090b; padding: 18px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.95; white-space: pre-wrap;"></pre>
        <p id="agent-note" style="margin: 14px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--color-text-muted);"></p>
      </section>

      <section id="step-5">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
          <div> <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 14px;">step 05 · 30 seconds</div> <h2 style="margin: 0; font-size: 31px; line-height: 1.15; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Delegate something real</h2> </div>
          <button data-step="5" class="done-btn" style="flex-shrink: 0; font-family: var(--font-mono); font-size: 11.5px; padding: 8px 13px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-faint);">mark done</button>
        </div>
        <pre style="margin-top: 22px; border: 1px solid var(--color-border-subtle); background: #08090b; padding: 18px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.95; white-space: pre-wrap; color: var(--color-text-code);">$ triss ask --paths "src/**/*.js" \\
    --question "where is the API key read?"

  47 files · 18.3K in / 2.4K out via zai/glm-5.2
  src/config.js, src/mcp/server.js

cost: $0.0056 off-peak ($0.011 peak)</pre>
        <div style="margin-top: 24px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 16px;">
          <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent);">Install from source</div>
          <pre style="margin: 8px 0 0; font-family: var(--font-mono); font-size: 12.5px; white-space: pre-wrap; color: var(--color-text-code);">$ git clone https://github.com/ayleen/triss-coworker.git
$ cd triss-coworker && npm install && npm link
$ triss --version && triss status</pre>
          <p style="margin: 8px 0 0; font-size: 12.5px; color: var(--color-text-muted);">Verify with <code style="font-family: var(--font-mono); color: var(--color-accent);">triss status</code> — it shows the default provider, native role models, credential readiness, endpoints, and masked config sources. Keep in sync with <a href="https://github.com/ayleen/triss-coworker#readme" style="text-decoration: underline; text-underline-offset: 0.16em;">README</a>.</p>
        </div>
        <div style="margin-top: 24px; display: flex; gap: 12px; flex-wrap: wrap; font-size: 13px;">
          <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/configuration.md" style="border: 1px solid var(--color-border-strong); padding: 8px 12px; font-family: var(--font-mono);">Configuration →</a>
          <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/mcp.md" style="border: 1px solid var(--color-border-strong); padding: 8px 12px; font-family: var(--font-mono);">MCP setup →</a>
        </div>
      </section>
    </main>
  </div>

  <Footer />

  <script is:inline src="/scripts/getting-started.js" defer></script>
</Base>
