import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
  NODE_CHECK_COMMAND,
  PACKAGE_MANAGERS,
  STANDALONE_INSTALL_COMMAND,
  SOURCE_INSTALL_COMMANDS,
  STANDARD_WIZARD_COMMAND,
  ADVANCED_WIZARD_COMMAND,
  TERMINAL_PROVIDER_COMMANDS,
  STATUS_COMMAND,
  FIRST_TASK_COMMAND_LINES,
  AGENT_TARGETS,
  AGENT_HELP_COMMAND,
  MCP_STATUS_COMMAND,
  UPGRADE_042_COMMANDS,
  OPENCODE2_SETUP_COMMANDS,
  OMP_SETUP_COMMANDS,
  MUSE_SETUP_COMMANDS,
} from "../../data/setup.js";

function requireTarget(id: string) {
  const target = AGENT_TARGETS.find((entry) => entry.id === id);
  if (!target) throw new Error(`setup.js is missing the "${id}" agent target`);
  return target;
}
const claude = requireTarget("claude");
const codex = requireTarget("codex");
const terminal = requireTarget("terminal");
const defaultTargetId = "claude";
const defaultPmId = PACKAGE_MANAGERS[0].id;

const STEPS = [
  { num: "01", title: "Check Node" },
  { num: "02", title: "Install Triss" },
  { num: "03", title: "Configure a provider" },
  { num: "04", title: "Connect your agent" },
  { num: "05", title: "Delegate a task" },
];
---

<Base
  title="Get started with Triss"
  description="Install Triss, connect your chosen provider and agent, and complete your first delegated research task."
>
  <Header current="quickstart" />

  <section class="qs-hero" data-agent-content>
    <div class="qs-hero__eyebrow">quickstart</div>
    <h1>Your first delegated task.</h1>
    <p class="qs-hero__lede">
      Five steps take you from an empty shell to a delegated research task. You need
      Node.js ≥ 22.12 and a credential (an API key) for the provider you plan to use.
    </p>

    <div class="qs-choice">
      <p class="qs-choice__lead">
        The connection guide in step 4 differs by host. This page covers Claude Code, Codex,
        and terminal use — every variant is shown below, so nothing is lost without JavaScript.
      </p>
      <div class="qs-controls" data-qs="target-controls" hidden>
        <span class="qs-controls__label" id="qs-target-label">Where will you use Triss?</span>
        <div class="qs-tab-group" role="group" aria-labelledby="qs-target-label">
          {
            AGENT_TARGETS.map((target) => (
              <button
                type="button"
                class="qs-tab"
                data-target={target.id}
                aria-pressed={target.id === defaultTargetId ? "true" : "false"}
              >
                {target.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="qs-progress" data-qs="progress" hidden>
      <div class="qs-progress__track">
        <div id="progress-bar" class="qs-progress__fill"></div>
      </div>
      <span id="progress-label" class="qs-progress__label">0 / 5 done</span>
    </div>
  </section>

  <div
    class="quickstart-layout"
    style="max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-gutter); display: grid; grid-template-columns: 220px 1fr; gap: 56px; align-items: start;"
  >
    <aside
      class="quickstart-steps"
      aria-label="Quickstart steps"
      style="position: sticky; top: 92px; padding: 56px 0; display: flex; flex-direction: column; gap: 2px;"
    >
      {
        STEPS.map((step) => (
          <a href={`#step-${step.num.slice(-1)}`} class="qs-stepnav__link">
            <span class="qs-stepnav__num">{step.num}</span>
            {step.title}
          </a>
        ))
      }
    </aside>

    <main data-agent-content style="padding: 56px 0 40px; display: flex; flex-direction: column; gap: 64px; min-width: 0;">
      <section id="step-1" class="qs-step">
        <div class="qs-step__head">
          <div>
            <div class="qs-step__eyebrow">step 01</div>
            <h2 class="qs-step__title">Check Node</h2>
          </div>
          <div class="qs-done-controls" data-qs="done-controls" hidden>
            <button type="button" class="qs-done" data-step="1" aria-pressed="false">mark done</button>
          </div>
        </div>
        <p class="qs-step__body">
          Triss requires Node.js ≥ 22.12. Print your current version and, if it is older,
          install a current Node.js release before continuing.
        </p>
        <pre tabindex="0" class="code-block qs-cmd"><code>{`$ ${NODE_CHECK_COMMAND}`}</code></pre>
      </section>

      <section id="step-2" class="qs-step">
        <div class="qs-step__head">
          <div>
            <div class="qs-step__eyebrow">step 02</div>
            <h2 class="qs-step__title">Install Triss</h2>
          </div>
          <div class="qs-done-controls" data-qs="done-controls" hidden>
            <button type="button" class="qs-done" data-step="2" aria-pressed="false">mark done</button>
          </div>
        </div>
        <p class="qs-step__body">
          Install the CLI globally with npm, or pick another package manager below. Every labeled
          variant stays visible until JavaScript narrows the list to your selection.
        </p>
        <div class="qs-controls qs-controls--inline" data-qs="pm-controls" hidden>
          <span class="qs-controls__label" id="qs-pm-label">Install with</span>
          <div class="qs-tab-group" role="group" aria-labelledby="qs-pm-label">
            {
              PACKAGE_MANAGERS.map((pm) => (
                <button
                  type="button"
                  class="qs-tab"
                  data-pm={pm.id}
                  aria-pressed={pm.id === defaultPmId ? "true" : "false"}
                >
                  {pm.label}
                </button>
              ))
            }
          </div>
        </div>
        {
          PACKAGE_MANAGERS.map((pm) => (
            <div class="qs-panel" data-install-panel={pm.id}>
              <div class="qs-panel__label">{pm.label}</div>
              <pre tabindex="0" class="code-block qs-cmd"><code>{`$ ${pm.command}`}</code></pre>
            </div>
          ))
        }
        <p class="qs-step__body">
          Prefer the npm-free standalone installer, or building from source? Both are listed in
          <a href="#alt-install">Alternative installation methods</a> below the steps.
        </p>
      </section>

      <section id="step-3" class="qs-step">
        <div class="qs-step__head">
          <div>
            <div class="qs-step__eyebrow">step 03</div>
            <h2 class="qs-step__title">Configure a provider</h2>
          </div>
          <div class="qs-done-controls" data-qs="done-controls" hidden>
            <button type="button" class="qs-done" data-step="3" aria-pressed="false">mark done</button>
          </div>
        </div>
        <p class="qs-step__body">
          Triss runs model calls through one canonical provider runtime, and you choose whose
          credential to use — for example <code>openai-compatible</code>, <code>zai</code>,
          <code>opencode-zen</code>, <code>opencode-go</code>, <code>moonshot</code>, or
          <code>kimi-for-coding</code>. The wizard's standard path (its default) configures
          the <code>openai-compatible</code> profile — it asks for the API key, a main model,
          and a small model — then asks which host to connect: Claude Code, Codex, or both.
          It installs the MCP server and agent rules for your selection:
        </p>
        <pre tabindex="0" class="code-block qs-cmd"><code>{`$ ${STANDARD_WIZARD_COMMAND}`}</code></pre>
        <p class="qs-step__body">
          Two behaviors of the current version matter here. First, standard mode writes the
          <code>openai-compatible</code> profile specifically — for a different provider such
          as <code>zai</code> or <code>moonshot</code>, run the full wizard with
          <code>{ADVANCED_WIZARD_COMMAND}</code>, which walks the provider catalogue, presets,
          base URL, and integrations. Second, this version does not offer a Skip option in
          Standard mode — the host question always gets one of the three answers. For a
          terminal-only setup with no host wiring, set the same profile directly:
        </p>
        <pre tabindex="0" class="code-block qs-cmd"><code>{TERMINAL_PROVIDER_COMMANDS.map((line) => `$ ${line}`).join("\n")}</code></pre>
        <p class="qs-step__body">
          <code>&lt;...&gt;</code> values are placeholders for your own key and model ids. You
          can also omit the value and enter it interactively — key and token values are
          masked as you type. With no host wired, nothing is written to Claude Code or Codex;
          the CLI alone is enough for the workflows on this site.
        </p>
        <p class="qs-step__body">Then check that your configuration is ready:</p>
        <pre tabindex="0" class="code-block qs-cmd"><code>{`$ ${STATUS_COMMAND}`}</code></pre>
        <p class="qs-step__body">
          <code>triss status</code> lists every provider with its credential state (ready or
          missing), the default provider and role models, and which env file each value came
          from — secrets are masked. You are ready when your chosen provider's credential is
          present and the defaults point where you intend.
        </p>
        <p class="qs-step__body">
          Upgrading from a pre-0.42 release? <a href="#upgrade-042">Run the migration first</a>.
          The full provider and field reference lives in the
          <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/configuration.md">configuration documentation</a>.
        </p>
      </section>

      <section id="step-4" class="qs-step">
        <div class="qs-step__head">
          <div>
            <div class="qs-step__eyebrow">step 04</div>
            <h2 class="qs-step__title">Connect your agent</h2>
          </div>
          <div class="qs-done-controls" data-qs="done-controls" hidden>
            <button type="button" class="qs-done" data-step="4" aria-pressed="false">mark done</button>
          </div>
        </div>
        <p class="qs-step__body">
          Connect Triss to the host where you will use it — the guide for each host is below.
          If the standard wizard in step 3 already wired the host you selected, verify the
          result with <code>{MCP_STATUS_COMMAND}</code> and restart that host's session
          instead of re-running setup. Terminal users skip host wiring entirely — the CLI is
          the whole interface for that target.
        </p>

        <div class="qs-panel qs-panel--agent" data-agent-panel={claude.id}>
          <h3 class="qs-panel__heading">{claude.label}</h3>
          <pre tabindex="0" class="code-block qs-cmd"><code>{[claude.setupComment, ...claude.setupCommands].join("\n")}</code></pre>
          <p class="qs-panel__body">
            <code>triss mcp install --target claude --global</code> registers the Triss MCP
            server in Claude Code's global agent config; <code>triss init --target claude --global</code>
            adds the Triss delegation rules at the same global scope. Restart
            your Claude Code session so the new server and rules load, then confirm the
            registration with <code>{MCP_STATUS_COMMAND}</code> or <code>{STATUS_COMMAND}</code>.
          </p>
          <p class="qs-panel__body">
            For a single-project registration, <code>triss mcp install</code> also accepts
            <code>--local</code>, which writes <code>./.mcp.json</code> in the current project;
            the global install follows your session and does not pin one project. After
            connecting, <code>{AGENT_HELP_COMMAND}</code> prints the full delegation cookbook.
          </p>
        </div>

        <div class="qs-panel qs-panel--agent" data-agent-panel={codex.id}>
          <h3 class="qs-panel__heading">{codex.label}</h3>
          <pre tabindex="0" class="code-block qs-cmd"><code>{[codex.setupComment, ...codex.setupCommands].join("\n")}</code></pre>
          <p class="qs-panel__body">
            Both commands target Codex's global config — Triss has no project-local MCP config
            for Codex. Restart the Codex CLI after registering, then verify with
            <code>{MCP_STATUS_COMMAND}</code>. Current releases of the Codex CLI also ship
            <code>codex mcp list</code> to show registered servers; check your installed Codex
            CLI for the exact command. After connecting, <code>{AGENT_HELP_COMMAND}</code>
            prints the full delegation cookbook.
          </p>
        </div>

        <div class="qs-panel qs-panel--agent" data-agent-panel={terminal.id}>
          <h3 class="qs-panel__heading">{terminal.label}</h3>
          <p class="qs-panel__body">
            No host setup is needed for terminal use — the Triss CLI you installed in step 2 is
            the whole interface for this target. No MCP registration or agent rules are involved;
            continue with step 5 and run your first delegated task directly in the terminal.
          </p>
        </div>
      </section>

      <section id="step-5" class="qs-step">
        <div class="qs-step__head">
          <div>
            <div class="qs-step__eyebrow">step 05</div>
            <h2 class="qs-step__title">Delegate a real task</h2>
          </div>
          <div class="qs-done-controls" data-qs="done-controls" hidden>
            <button type="button" class="qs-done" data-step="5" aria-pressed="false">mark done</button>
          </div>
        </div>
        <p class="qs-step__body">
          From the root of a project that has a <code>README.md</code>, ask a focused question
          about it:
        </p>
        <pre tabindex="0" class="code-block qs-cmd"><code>{`$ ${FIRST_TASK_COMMAND_LINES.join("\n")}`}</code></pre>
        <p class="qs-step__body">
          This is an example input, not a recorded answer — read the output your own run
          produces. If your project has no <code>README.md</code>, point <code>--paths</code>
          at an existing text file. Check the cited lines in the sources before you rely on the
          answer: model answers can be wrong.
        </p>
        <p class="qs-step__body">
          For a recorded, source-linked research run over real Triss sources, see the
          <a href="/workflows/research/">research workflow</a>.
        </p>
        <div class="qs-next">
          <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/configuration.md">Configuration →</a>
          <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/mcp.md">MCP setup →</a>
        </div>
      </section>

      <section class="qs-after" aria-label="Reference and optional setup">
        <details id="upgrade-042" class="qs-details">
          <summary>Upgrading from older Triss versions</summary>
          <div class="qs-details__body">
            <p>
              Triss 0.42 replaces worker configuration and model presets with unified provider
              profiles. After installing the update and before running model commands:
            </p>
            <pre tabindex="0" class="code-block"><code>{UPGRADE_042_COMMANDS.join("\n")}</code></pre>
            <p>
              Restart MCP hosts and agent sessions after migration. Do not downgrade to a
              pre-0.42 release after migration.
            </p>
          </div>
        </details>

        <details class="qs-details" id="advanced-engines">
          <summary>Advanced model and engine setup</summary>
          <div class="qs-details__body">
            <p>
              The steps above use your chosen provider directly. These optional setups route
              work through a coding engine instead; see the linked engine documentation for the
              full contracts.
            </p>

            <div class="qs-sub">
              <div class="qs-sub__title">Optional: use the OpenCode 2 beta engine</div>
              <pre tabindex="0" class="code-block"><code>{OPENCODE2_SETUP_COMMANDS.map((line) => `$ ${line}`).join("\n")}</code></pre>
              <p class="qs-details__note">
                OpenCode 2 <code>0.0.0-beta-19059</code> or newer is accepted by default. Triss
                never pins an exact build and checks required option declarations rather than
                help-description wording. Lower or malformed
                <code>TRISS_CODER_OPENCODE2_VERSION</code> values fall back to that floor. See
                <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/engines/opencode2.md">docs/engines/opencode2.md</a>.
              </p>
            </div>

            <div class="qs-sub">
              <div class="qs-sub__title">Optional: use the native OMP coder engine</div>
              <pre tabindex="0" class="code-block"><code>{OMP_SETUP_COMMANDS.map((line) => `$ ${line}`).join("\n")}</code></pre>
              <p class="qs-details__note">
                OMP 18.0.6 or newer must already be installed; Triss only probes it and never
                runs the installer. OMP defaults to worktree isolation, but that is not
                host-filesystem confinement. The default credential mode is
                <code>best_effort_raw</code>; add <code>--protect-credentials</code> when the
                selected key must stay behind the parent-owned proxy. See
                <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/engines/omp.md">docs/engines/omp.md</a>.
              </p>
            </div>

            <div class="qs-sub">
              <div class="qs-sub__title">Optional: use OpenCode Go Muse for ask and review</div>
              <pre tabindex="0" class="code-block"><code>{MUSE_SETUP_COMMANDS.map((line) => `$ ${line}`).join("\n")}</code></pre>
              <p class="qs-details__note">
                Run <code>coder init</code> first: it verifies OpenCode, configures the key and
                provider, and writes the required engine configuration. The four
                <code>config set</code> commands then make bare <code>triss ask</code> and
                <code>triss review</code> use <code>opencode-go/muse-spark-1.3-contributor</code>.
                Every call installs and verifies a transient primary
                <code>triss-readonly-projection</code> agent that denies every tool by default
                and receives the complete request context in the prompt; it has no ambient file,
                shell, edit, skill, or delegation access. Pass a quoted glob such as
                <code>src/**/*.js</code> because directories are not read recursively. Explicit
                flags still win; add <code>--protect-credentials</code> when the key must stay
                behind the parent-owned proxy.
              </p>
            </div>
          </div>
        </details>

        <details id="alt-install" class="qs-details">
          <summary>Alternative installation methods</summary>
          <div class="qs-details__body">
            <p>
              npm is the primary route shown in step 2. The same public commands for the other
              package managers, the standalone installer, and a source build:
            </p>
            {
              PACKAGE_MANAGERS.filter((pm) => pm.id !== "npm").map((pm) => (
                <div class="qs-sub">
                  <div class="qs-sub__title">{pm.label}</div>
                  <pre tabindex="0" class="code-block"><code>{`$ ${pm.command}`}</code></pre>
                </div>
              ))
            }
            <div class="qs-sub">
              <div class="qs-sub__title">Standalone installer (no npm)</div>
              <pre tabindex="0" class="code-block"><code>{`$ ${STANDALONE_INSTALL_COMMAND}`}</code></pre>
              <p class="qs-details__note">
                Runs <code>install.sh</code> from the repository. It still requires Node.js.
              </p>
            </div>
            <div class="qs-sub">
              <div class="qs-sub__title">From source</div>
              <pre tabindex="0" class="code-block"><code>{SOURCE_INSTALL_COMMANDS.map((line) => `$ ${line}`).join("\n")}</code></pre>
              <p class="qs-details__note">
                Verify with <code>{STATUS_COMMAND}</code> after linking, and keep in sync with
                the <a href="https://github.com/ayleen/triss-coworker#readme">README</a>.
              </p>
            </div>
          </div>
        </details>
      </section>
    </main>
  </div>

  <Footer />

  <script is:inline src="/scripts/getting-started.js" defer></script>
</Base>

<style>
  /* Hero */
  .qs-hero {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 72px var(--layout-gutter) 44px;
    border-bottom: 1px solid var(--color-border);
  }
  .qs-hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-label);
    margin-bottom: 18px;
  }
  .qs-hero h1 {
    margin: 0;
    font-size: 52px;
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--color-text-strong);
    max-width: 22em;
  }
  .qs-hero__lede {
    margin: 22px 0 0;
    max-width: 42em;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* Host choice (progressive enhancement: controls stay hidden until JS init) */
  .qs-choice {
    margin-top: 30px;
  }
  .qs-choice__lead {
    margin: 0;
    max-width: 46em;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .qs-controls {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  /* The `display` declarations above must not defeat the `hidden` attribute
     that keeps the controls off the no-JS page until JS init succeeds. */
  .qs-controls[hidden],
  .qs-progress[hidden],
  .qs-done-controls[hidden] {
    display: none;
  }
  .qs-controls--inline {
    margin-top: 22px;
  }
  .qs-controls__label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-label);
  }
  .qs-tab-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .qs-tab {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 11px 20px;
    cursor: pointer;
    border: none;
    background: var(--color-bg-raised);
    color: var(--color-text-muted);
  }
  .qs-tab[aria-pressed="true"] {
    background: #08090b;
    color: var(--color-accent);
  }

  /* Manual progress checklist (JS-only affordance) */
  .qs-progress {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
    max-width: 520px;
  }
  .qs-progress__track {
    flex: 1;
    height: 3px;
    background: var(--color-border);
    overflow: hidden;
  }
  .qs-progress__fill {
    height: 3px;
    background: var(--color-accent);
    width: 0%;
  }
  .qs-progress__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  /* Sidebar step nav */
  .qs-stepnav__link {
    display: flex;
    gap: 12px;
    padding: 9px 10px;
    font-size: 13.5px;
    color: var(--color-text-secondary);
  }
  .qs-stepnav__num {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-text-label);
    padding-top: 2px;
  }

  /* Steps */
  .qs-step__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .qs-step__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-label);
    margin-bottom: 14px;
  }
  .qs-step__title {
    margin: 0;
    font-size: 31px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--color-text-strong);
  }
  .qs-step__body {
    margin: 14px 0 0;
    max-width: 44em;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .qs-done {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 8px 13px;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-faint);
  }
  .qs-done[aria-pressed="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .qs-cmd {
    margin-top: 22px;
    max-width: 100%;
  }
  .qs-next {
    margin-top: 24px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .qs-next a {
    border: 1px solid var(--color-border-strong);
    padding: 8px 12px;
