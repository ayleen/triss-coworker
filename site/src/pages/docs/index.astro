import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Base title="Documentation — Triss" description="Guides, workflows, and reference documentation for working with Triss.">
  <Header current="docs" />
  <main style="max-width: var(--layout-max); margin: 0 auto; padding: 72px var(--layout-gutter);">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">documentation</div>
    <h1 style="margin: 0; font-size: clamp(2rem, 4.5vw, 2.75rem); overflow-wrap: anywhere; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Documentation</h1>
    <p style="margin: 14px 0 0; max-width: 42em; font-size: 16px; line-height: 1.6; color: var(--color-text-secondary);">Guides, workflows, and reference documentation for working with Triss.</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 32px;">
      <div style="background: var(--color-bg-raised); padding: 22px;">
        <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase;">start here</div>
        <ul style="margin: 12px 0 0; padding: 0; list-style: none; line-height: 2; font-size: 14px;">
          <li><a href="/docs/getting-started/">Getting started — your first delegated task</a></li>
          <li><a href="/workflows/">Workflows — research, review, implementation</a></li>
          <li><a href="/workflows/research/">Delegate codebase research</a></li>
          <li><a href="/workflows/review/">Get a second code review</a></li>
          <li><a href="/workflows/implementation/">Delegate an implementation task</a></li>
        </ul>
      </div>
      <div style="background: var(--color-bg-raised); padding: 22px;">
        <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase;">delegation & reference</div>
        <ul style="margin: 12px 0 0; padding: 0; list-style: none; line-height: 2; font-size: 14px;">
          <li><a href="/commands">Commands reference</a></li>
          <li><a href="/coder">Coder — coding engines and worktree isolation</a></li>
          <li><a href="/integrations">Integrations overview</a></li>
          <li><a href="/cost">Inference costs and methodology</a></li>
          <li><a href="/security">Security &amp; privacy</a></li>
        </ul>
      </div>
      <div style="background: var(--color-bg-raised); padding: 22px;">
        <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase;">GitHub documentation</div>
        <ul style="margin: 12px 0 0; padding: 0; list-style: none; line-height: 2; font-size: 14px;">
          <li><a href="https://github.com/ayleen/triss-coworker#quickstart">Quickstart (README)</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker#configuration">Configuration — wizard</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker#when-to-use-triss">What Triss does (README)</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker#mcp">Connect your agent over MCP (README)</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/docs/mcp.md">MCP — Claude Code / Codex</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/docs/configuration.md">Provider and engine configuration</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/docs/usage-accounting.md">Usage accounting</a></li>
        </ul>
      </div>
      <div style="background: var(--color-bg-raised); padding: 22px;">
        <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase;">tracker setup guides</div>
        <ul style="margin: 12px 0 0; padding: 0; list-style: none; line-height: 2; font-size: 14px;">
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/docs/integrations/jira.md">Jira</a> · <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/integrations/linear.md">Linear</a> · <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/integrations/github.md">GitHub</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/docs/integrations/gitlab.md">GitLab</a> · <a href="https://github.com/ayleen/triss-coworker/blob/main/docs/integrations/confluence.md">Confluence</a></li>
        </ul>
      </div>
      <div style="background: var(--color-bg-raised); padding: 22px;">
        <div style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase;">extend &amp; contribute</div>
        <ul style="margin: 12px 0 0; padding: 0; list-style: none; line-height: 2; font-size: 14px;">
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/docs/extending.md">Add a provider</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/CONTRIBUTING.md">Contributing</a></li>
          <li><a href="https://github.com/ayleen/triss-coworker/blob/main/SECURITY.md">Security</a></li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</Base>
