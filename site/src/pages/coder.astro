import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Coding engines and execution — Triss" description="Run implementation tasks through supported coding engines and understand worktree isolation, results, and verification.">
  <Header current="coder" />

  <main>
  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 72px var(--layout-gutter) 68px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; border-bottom: 1px solid var(--color-border);">
    <div>
      <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">triss coder</div>
      <h1 style="margin: 0; font-size: 52px; line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--color-text-strong); max-width: 20em;">The part where she writes the code.</h1>
      <p style="margin: 22px 0 0; max-width: 40em; font-size: 17px; line-height: 1.65; color: var(--color-text-secondary);">
        <code style="font-family: var(--font-mono); color: var(--color-accent);">triss coder</code> runs bounded implementation tasks through your selected coding engine. Inspect the resulting changes before accepting them.
      </p>
      <p style="margin: 16px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-text-secondary);">
        <a href="/workflows/implementation/" style="color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.16em;">Follow the implementation workflow</a> — from a bounded task to an inspected, accepted change.
      </p>
    </div>
    <div style="border: 1px solid var(--color-border-strong); background: var(--color-bg-code);">
      <div style="padding: 12px 16px; border-bottom: 1px solid var(--color-border-subtle); font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">a whole task, delegated</div>
      <div style="padding: 20px 22px; font-family: var(--font-mono); font-size: 13px; line-height: 1.9;">
        <div style="white-space: pre-wrap; color: var(--color-text-code);">$ triss coder init</div>
        <div style="white-space: pre-wrap; color: var(--color-text-faint);">  engine? provider? key? → done once</div>
        <div style="height: 24px;"></div>
        <div style="white-space: pre-wrap; color: var(--color-text-code);">$ triss coder run \</div>
        <div style="white-space: pre-wrap; color: var(--color-text-code);">    "add input validation to /signup" \</div>
        <div style="white-space: pre-wrap; color: var(--color-text-code);">    --isolate</div>
        <div style="height: 24px;"></div>
        <div style="white-space: pre-wrap; color: var(--color-accent);">→ 3 files changed in .triss/wt/signup</div>
        <div style="white-space: pre-wrap; color: var(--color-text-secondary);">→ your working tree: untouched</div>
      </div>
    </div>
  </section>

  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 88px var(--layout-gutter);">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">engines</div>
    <h2 style="margin: 0; font-size: 38px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Pick one engine. Keep the same public model IDs.</h2>
    <div role="group" aria-label="Coder engine" style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 28px;">
      <button data-engine="opencode" class="engine-btn" aria-pressed="true" style="font-family: var(--font-mono); font-size: 13px; padding: 10px 16px; cursor: pointer; background: var(--color-accent); color: #0b0d10; border: 1px solid var(--color-accent);">opencode <span>default</span></button>
      <button data-engine="opencode2" class="engine-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 13px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">opencode2 <span>beta</span></button>
      <button data-engine="crush" class="engine-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 13px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">crush <span>interim</span></button>
      <button data-engine="omp" class="engine-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 13px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">omp <span>new</span></button>
      <button data-engine="harness" class="engine-btn" aria-pressed="false" style="font-family: var(--font-mono); font-size: 13px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">harness bundle <span>DSH plugin, not --engine</span></button>
    </div>
    <div id="engine-body" style="margin-top: 24px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 24px;"></div>
    <div style="margin-top: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--color-text-label);" id="engine-flag"></div>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px;">
      <code id="engine-command" style="font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); background: var(--color-bg-code); border: 1px solid var(--color-border-subtle); padding: 9px 11px;"></code>
      <button id="copy-engine-command" type="button" style="min-height: 44px; font-family: var(--font-mono); font-size: 12px; padding: 9px 13px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">copy command</button>
    </div>
  </section>

  <section class="coder-path" style="max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-gutter) 80px;">
    <h2 style="font-size: 28px; color: var(--color-text-strong);">From run to accepted change</h2>
    <p style="color: var(--color-text-secondary);">The same path with or without JavaScript: run, locate the result, inspect every class of change, verify, then decide.</p>
    <ol class="coder-path__steps">
      <li>
        <span class="coder-path__step-title">Run a bounded task</span>
        <code class="coder-path__cmd" tabindex="0">triss coder run --engine &lt;engine&gt; --isolate "the bounded task"</code>
        <span class="coder-path__note">The prompt describes the task; it does not create a sandbox policy. <code class="coder-path__inline">--isolate</code> gives you a disposable Git worktree, not an operating-system sandbox.</span>
      </li>
      <li>
        <span class="coder-path__step-title">Locate the result</span>
        <code class="coder-path__cmd" tabindex="0">triss coder result list</code>
        <span class="coder-path__note">Or list sessions per engine: <code class="coder-path__inline">triss coder session list --engine &lt;engine&gt;</code>. The JSON envelope reports the worktree path for isolated runs; retention of a result artifact is not guaranteed for every run.</span>
      </li>
      <li>
        <span class="coder-path__step-title">Inspect the actual worktree</span>
        <code class="coder-path__cmd" tabindex="0">git -C "$WORKTREE" status --short &amp;&amp; git -C "$WORKTREE" diff --cached &amp;&amp; git -C "$WORKTREE" diff</code>
        <span class="coder-path__note">Also check untracked files: <code class="coder-path__inline">git -C "$WORKTREE" ls-files --others --exclude-standard</code>. Staged and untracked changes are part of the result — a diff alone is not the whole picture.</span>
      </li>
      <li>
        <span class="coder-path__step-title">Verify, then accept or reject</span>
        <span class="coder-path__note">Run the project's focused checks in the worktree yourself; a zero exit code is not proof the task is correct. Accept through your normal Git process — review, commit, pull request. To discard a specific retained result: <code class="coder-path__inline">triss coder result clean &lt;run-id&gt;</code>; a specific inactive session: <code class="coder-path__inline">triss coder session clean &lt;slug&gt; --engine &lt;engine&gt;</code>.</span>
      </li>
    </ol>
    <p class="coder-path__limits">Capability and isolation verdicts (<code class="coder-path__inline">effective_isolation</code>, <code class="coder-path__inline">execution_capabilities</code>) describe the current implementation per engine and route. Where a run reports <code class="coder-path__inline">best_effort</code> or <code class="coder-path__inline">unavailable</code>, treat it as a disclosed limitation of this version and decide accordingly — not as a guaranteed property of every route, and not as a reason an engine is permanently unusable. See the <a class="coder-path__link" href="https://github.com/ayleen/triss-coworker/blob/main/docs/reliable-delegation-contract.md">reliable delegation contract</a>.</p>
  </section>

  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-gutter) 80px;">
    <h2 style="font-size: 28px; color: var(--color-text-strong);">The envelope you actually review</h2>
    <p style="color: var(--color-text-secondary);">One JSON envelope printed to stdout per run — honest about isolation, files changed, and capabilities.</p>
    <div style="display: grid; grid-template-columns: 240px 1fr; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 24px;">
      <div id="field-list" style="background: var(--color-bg); display: flex; flex-direction: column;"></div>
      <div style="background: var(--color-bg-code); padding: 20px;">
        <div id="field-title" style="font-size: 15px; font-weight: 600; color: var(--color-text-heading);"></div>
        <div id="field-body" style="margin-top: 8px; font-size: 13.5px; line-height: 1.6; color: var(--color-text-secondary);"></div>
        <code id="field-hint" style="display: block; margin-top: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); background: rgba(95,180,100,0.08); border: 1px solid rgba(95,180,100,0.35); padding: 8px 10px;"></code>
      </div>
    </div>
  </section>

  </main>

  <style>
    .coder-path__steps { margin: 28px 0 0; padding: 0; list-style: none; counter-reset: coder-step; display: grid; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
    .coder-path__steps li { background: var(--color-bg-raised); padding: 20px 22px; display: flex; flex-direction: column; gap: 8px; counter-increment: coder-step; min-width: 0; }
    .coder-path__step-title::before { content: counter(coder-step) ". "; color: var(--color-text-label); font-family: var(--font-mono); }
    .coder-path__step-title { font-size: 15px; font-weight: 600; color: var(--color-text-heading); letter-spacing: -0.02em; }
    .coder-path__cmd { display: block; font-family: var(--font-mono); font-size: 12.5px; color: var(--color-accent); background: var(--color-bg-code); border: 1px solid var(--color-border-subtle); padding: 9px 11px; overflow-x: auto; white-space: pre; }
    .coder-path__note { font-size: 13.5px; line-height: 1.65; color: var(--color-text-secondary); overflow-wrap: anywhere; }
    .coder-path__inline { font-family: var(--font-mono); font-size: 12px; color: var(--color-text-muted); }
    .coder-path__limits { margin: 22px 0 0; font-size: 13px; line-height: 1.65; color: var(--color-text-muted); max-width: 72ch; }
    .coder-path__link { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.16em; }
  </style>

  <Footer />

  <script>
// @ts-nocheck
    const ENGINES = {
      opencode: { body: "The V1 engine and the stable default. Its deny-first bash allowlist in opencode.json is enforced. Zen and Go runs keep native OpenCode provider behavior. Protected mode forwards only User-Agent plus session, request, and client identity; the project fingerprint stays local.", flag: "--engine opencode", isolation: "opt-in via --isolate" },
      opencode2: { body: "The V2 beta. OpenCode 2 0.0.0-beta-19059 or newer is accepted by default — the supported floor plus every newer parseable version, never one pinned build; Triss checks required option declarations, not help descriptions. It shares the same opencode.json config and provider catalogue. Credential handling defaults to best_effort_raw; pass --protect-credentials for the parent-owned credential proxy.", flag: "--engine opencode2", isolation: "opt-in via --isolate" },
      crush: { body: "Isolation is ON by default: the run happens in a disposable worktree that separates changes from your checkout. That worktree is not an operating-system sandbox. By default the engine auto-approves its tools; --restrict opts into the CLI allowlist enforcement for this run.", flag: "--engine crush", isolation: "ON by default" },
      omp: { body: "Native OMP headless adapter with structured events and named sessions. Run-private config prevents profile inheritance. It defaults to worktree isolation and best_effort_raw credential handling; --protect-credentials uses the parent-owned proxy. A worktree is not an OS sandbox.", flag: "--engine omp", isolation: "ON by default" },
      harness: { body: "Not an --engine value — opt-in DSH companion bundle. One profile dependency instead of hand-authoring provider mapping.", flag: "dsh plugin add triss-dsh-provider-bundle", isolation: "owned by Harness" },
    };
    let engine = "opencode";
    function renderEngine() {
      const e = ENGINES[engine];
      document.getElementById("engine-body").innerHTML = "<div style='font-size:15px; font-weight:600; color:var(--color-text-heading);'>" + engine + "</div><p style='margin:8px 0 0; font-size:13.5px; line-height:1.6; color:var(--color-text-secondary);'>" + e.body + "</p><div style='margin-top:12px; font-family:var(--font-mono); font-size:12px;'><span style='background:var(--color-bg-code); border:1px solid var(--color-border-subtle); padding:6px 10px; color:var(--color-accent);'>" + e.flag + "</span> <span style='color:var(--color-text-label); margin-left:8px;'>isolation: " + e.isolation + "</span></div>";
      document.getElementById("engine-flag").textContent = e.flag + " · isolation: " + e.isolation;
      const command = engine === "harness"
        ? e.flag
        : `triss coder run ${e.flag} "your task"`;
      document.getElementById("engine-command").textContent = command;
      const copyButton = document.getElementById("copy-engine-command");
      copyButton.textContent = "copy command";
      copyButton.setAttribute("aria-label", `Copy ${engine} command`);
      document.querySelectorAll(".engine-btn").forEach(b => {
        const on = b.getAttribute("data-engine")===engine;
        b.setAttribute("aria-pressed", String(on));
        b.style.background = on ? "var(--color-accent)" : "transparent";
        b.style.color = on ? "#0b0d10" : "var(--color-text-muted)";
        b.style.borderColor = on ? "var(--color-accent)" : "var(--color-border-strong)";
      });
    }
    const engineButtons = [...document.querySelectorAll(".engine-btn")];
    engineButtons.forEach((button, index) => {
      button.addEventListener("click", () => { engine = button.getAttribute("data-engine"); renderEngine(); });
      button.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        const next = engineButtons[(index + offset + engineButtons.length) % engineButtons.length];
        next.focus();
        next.click();
      });
    });
    document.getElementById("copy-engine-command").addEventListener("click", async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(document.getElementById("engine-command").textContent);
        button.textContent = "copied";
      } catch {
        button.textContent = "copy unavailable";
      }
    });
    renderEngine();

    const FIELDS = [
      { key: "session_slug", title: "Never an implicit conversation", body: "Either the slug you passed or a generated anonymous one. A run never silently continues a previous session.", hint: "triss coder session list" },
      { key: "files_changed", title: "Null unless isolated", body: "Only an isolated run can honestly count changed files. Otherwise this is null.", hint: "--isolate" },
      { key: "worktree", title: "A disposable checkout", body: "The isolated run happens here, never in your working tree. Triss waits for residual processes.", hint: ".triss/wt/<slug>" },
      { key: "effective_isolation", title: "Enforced, or honestly downgraded", body: "Fails before spawn unless you opted into best-effort. Advisory only when downgraded.", hint: "--allow-best-effort-caller-worktree" },
      { key: "execution_capabilities", title: "Eight honest verdicts", body: "Each capability reports enforced, best_effort, or unavailable — verified for the run.", hint: "docs/reliable-delegation-contract.md" },
    ];
    let field = "files_changed";
    function renderField() {
      const list = document.getElementById("field-list");
      if (!list) return;
      list.innerHTML = "";
      FIELDS.forEach(f => {
        const b = document.createElement("button");
        b.textContent = f.key;
        b.style.cssText = "text-align:left; padding:10px 14px; font-family:var(--font-mono); font-size:12px; cursor:pointer; border:none; border-bottom:1px solid var(--color-border-subtle); background:" + (f.key===field ? "var(--color-bg-raised)" : "transparent") + "; color:" + (f.key===field ? "var(--color-accent)" : "var(--color-text-muted)");
        b.setAttribute("aria-pressed", String(f.key===field));
        b.addEventListener("click", () => { field=f.key; renderField(); });
        list.appendChild(b);
      });
      const cur = FIELDS.find(f=>f.key===field);
      document.getElementById("field-title").textContent = cur.title;
      document.getElementById("field-body").textContent = cur.body;
      document.getElementById("field-hint").textContent = cur.hint;
    }
    renderField();
  </script>
</Base>
