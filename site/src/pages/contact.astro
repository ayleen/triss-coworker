import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const REPO = "https://github.com/ayleen/triss-coworker";
---

<Base title="Contact — Triss" description="How to reach the Triss project: GitHub issues for bugs and features, SECURITY.md for vulnerability reports, CONTRIBUTING.md for patches.">
  <Header />

  <main>
    <section style="max-width: var(--layout-max); margin: 0 auto; padding: 68px var(--layout-gutter) 44px; border-bottom: 1px solid var(--color-border);">
      <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">contact</div>
      <h1 style="margin: 0; font-size: 52px; line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--color-text-strong); max-width: 22em;">Triss is maintained in the open — talk to us on GitHub.</h1>
      <p style="margin: 22px 0 0; max-width: 44em; font-size: 17px; line-height: 1.65; color: var(--color-text-secondary);">
        There is no support desk or sales team behind Triss; the repository is the channel.
        Everything arrives in the public tracker at
        <a href={`${REPO}/issues`} rel="noopener">github.com/ayleen/triss-coworker/issues</a>, where
        maintainers and contributors respond in the open.
      </p>
    </section>

    <section class="sec-trust" style="max-width: var(--layout-max); margin: 0 auto; padding: 72px var(--layout-gutter) 0;">
      <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">channels</div>
      <h2 style="margin: 0; font-size: 28px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Pick the right door.</h2>
      <div class="sec-trust__grid">
        <div class="sec-trust__item">
          <div class="sec-trust__q">Bugs and feature requests</div>
          <p class="sec-trust__a">Open a <a class="sec-trust__link" href={`${REPO}/issues`} rel="noopener">GitHub issue</a> with the command you ran, the version (<code style="font-family: var(--font-mono);">triss status</code> prints it), and what you expected. Never paste credentials or provider keys.</p>
        </div>
        <div class="sec-trust__item">
          <div class="sec-trust__q">Security vulnerabilities</div>
          <p class="sec-trust__a">Do not open a public issue. Follow <a class="sec-trust__link" href={`${REPO}/blob/main/SECURITY.md`} rel="noopener">SECURITY.md</a> — it describes the coordinated disclosure path, including how to request a private contact channel when one is needed.</p>
        </div>
        <div class="sec-trust__item">
          <div class="sec-trust__q">Code and documentation changes</div>
          <p class="sec-trust__a">Pull requests are welcome under the Developer Certificate of Origin. Read <a class="sec-trust__link" href={`${REPO}/blob/main/CONTRIBUTING.md`} rel="noopener">CONTRIBUTING.md</a> first: behavior changes ship with tests, and <code style="font-family: var(--font-mono);">npm run check</code> must pass.</p>
        </div>
        <div class="sec-trust__item">
          <div class="sec-trust__q">Usage questions</div>
          <p class="sec-trust__a">Start with the <a class="sec-trust__link" href="/docs/">documentation</a> and the <a class="sec-trust__link" href="/commands/">command reference</a>; <code style="font-family: var(--font-mono);">triss agent-help</code> prints the full delegation cookbook locally. If the docs are wrong or unclear, that is a bug — file it.</p>
        </div>
      </div>
      <p class="sec-trust__caveat">
        Response times are best-effort: this is an open-source project maintained by volunteers,
        not a commercial SLA. For security reports, the disclosure policy in SECURITY.md applies.
      </p>
    </section>
  </main>

  <Footer />

  <style>
    .sec-trust__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 28px; }
    .sec-trust__item { background: var(--color-bg-raised); padding: 20px 22px; min-width: 0; }
    .sec-trust__q { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
    .sec-trust__a { margin: 8px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--color-text-secondary); }
    .sec-trust__link { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.16em; }
    .sec-trust__caveat { margin: 22px 0 0; font-size: 13px; line-height: 1.65; color: var(--color-text-muted); max-width: 72ch; }
    @media (max-width: 760px) {
      .sec-trust__grid { grid-template-columns: 1fr; }
    }
  </style>
</Base>
