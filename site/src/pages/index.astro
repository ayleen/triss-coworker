---
// SPDX-License-Identifier: MIT
// Copyright (c) 2026 ayleen

import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DelegationExample from "../components/DelegationExample.astro";
import { WORKFLOWS } from "../data/workflows.js";
import pkg from "../../../package.json";

const SITE = (Astro.site?.toString().replace(/\/$/, "")) || "https://triss.work";
const REPO = "https://github.com/ayleen/triss-coworker";
const orgId = `${SITE}/#organization`;
// Machine-readable identity for AI agents (parsed from the homepage).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Triss",
      description:
        "Delegate codebase research, reviews, and implementation through a local CLI and MCP server. Choose your models and engines. Keep control of what ships.",
      url: `${SITE}/`,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Node.js >= 22.12",
      softwareVersion: pkg.version,
      isAccessibleForFree: true,
      license: `${REPO}/blob/main/LICENSE`,
      downloadUrl: "https://www.npmjs.com/package/triss-coworker",
      author: { "@id": orgId },
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "Organization",
      "@id": orgId,
      name: "Triss",
      url: `${SITE}/`,
      logo: `${SITE}/icon-512.png`,
      sameAs: [REPO, "https://www.npmjs.com/package/triss-coworker"],
      contactPoint: [
        {
          "@type": "ContactPoint",
          contactType: "technical support",
          url: `${REPO}/issues`,
        },
      ],
    },
  ],
};
---

<Base
  title="Triss — Managed delegation for AI development"
  description="Delegate codebase research, reviews, and implementation through a local CLI and MCP server. Choose your models and engines. Keep control of what ships."
  jsonLd={jsonLd}
>
  <Header />

  <main>
    <!-- Hero: text and CTAs on the left, recorded example on the right -->
    <section id="top" class="home-hero">
      <div class="home-hero__intro">
        <span class="home-hero__eyebrow">Managed delegation for AI development</span>
        <h1 class="home-hero__title">Give your coding agent a coworker.</h1>
        <p class="home-hero__lede">
          Delegate codebase research, reviews, and implementation through Triss. Use your
          preferred models and coding engines. Keep control of what ships.
        </p>
        <p class="home-hero__supporting">
          An open-source CLI and MCP server for Claude Code, Codex, and your terminal.
        </p>
        <div class="home-hero__actions">
          <a class="btn-primary" href="/docs/getting-started/">Get started</a>
          <a class="btn-secondary" href="#delegation-example">See a real example</a>
        </div>
        <div class="home-hero__install">
          <code class="home-hero__install-command" id="install-command">npm install -g triss-coworker</code>
          <button id="copy-install-btn" class="btn-secondary" type="button">Copy install command</button>
        </div>
      </div>
      <DelegationExample compact id="delegation-example" />
    </section>

    <!-- Three workflow cards -->
    <section class="page-section" style="border-top: 1px solid var(--color-border);">
      <p class="page-section__label">01 — workflows</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">
        Three workflows to start with
      </h2>
      <div class="workflow-grid">
        {WORKFLOWS.map((workflow) => (
          <article class="workflow-card">
            <h3 class="workflow-card__title">{workflow.title}</h3>
            <p class="workflow-card__body">{workflow.description}</p>
            <a class="workflow-card__cta" href={workflow.href}>{workflow.cta} →</a>
          </article>
        ))}
      </div>
      <p style="margin-top: 22px;">
        <a href="/workflows/" style="font-family: var(--font-mono); font-size: 13px;">All workflows →</a>
      </p>
    </section>

    <!-- How it works -->
    <section id="how" class="page-section" style="border-top: 1px solid var(--color-border);">
      <p class="page-section__label">02 — how it works</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">
        Delegate the work. Keep the decisions.
      </h2>
      <ol class="how-steps">
        <li>
          <h3>Your agent defines the task</h3>
          <p>Choose the question, context, and acceptance criteria.</p>
        </li>
        <li>
          <h3>Triss invokes the configured route</h3>
          <p>Use the selected provider, model, and execution engine through CLI or MCP.</p>
        </li>
        <li>
          <h3>You receive a result to inspect</h3>
          <p>Read findings, source references, or implementation changes.</p>
        </li>
        <li>
          <h3>You decide what to use</h3>
          <p>Verify the evidence and changes before accepting them.</p>
        </li>
      </ol>
    </section>

    <!-- Why add Triss to an agent you already use -->
    <section class="page-section" style="border-top: 1px solid var(--color-border); background: #0d0f13;">
      <p class="page-section__label">03 — why triss</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong); max-width: 22em;">
        Why add Triss to an agent you already use?
      </h2>
      <p style="margin: 18px 0 0; max-width: 46em; font-size: 16.5px; line-height: 1.65; color: var(--color-text-secondary);">
        Keep your existing agent. Use Triss when you want a shared interface for delegated work
        across supported models, coding engines, and project tools.
      </p>
      <div class="workflow-grid">
        <article class="workflow-card">
          <h3 class="workflow-card__title">A common interface</h3>
          <p class="workflow-card__body">Use the same provider configuration through CLI and MCP.</p>
        </article>
        <article class="workflow-card">
          <h3 class="workflow-card__title">Task-specific workflows</h3>
          <p class="workflow-card__body">
            Read selected context, review changes, or delegate an implementation task without
            inventing a new prompt-and-script workflow each time.
          </p>
        </article>
        <article class="workflow-card">
          <h3 class="workflow-card__title">Results you can inspect</h3>
          <p class="workflow-card__body">
            Keep findings, changes, execution details, and usage information available for review.
          </p>
        </article>
      </div>
      <p style="margin: 26px 0 0; max-width: 46em; font-size: 14px; line-height: 1.65; color: var(--color-text-muted);">
        If your agent's built-in tools already meet your needs, you may not need another layer.
        Triss is useful when you want explicit delegation and a common interface across tools.
      </p>
    </section>

    <!-- Controls and boundaries -->
    <section class="page-section" style="border-top: 1px solid var(--color-border);">
      <p class="page-section__label">04 — controls and boundaries</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">
        Your choices. Clear boundaries.
      </h2>
      <div class="boundary-grid">
        <div class="boundary-item">
          <h3>Models and engines</h3>
          <p>
            Choose the supported provider, model, and engine for the work. Check the
            <a href="/docs/">configuration guide</a> for current route requirements.
          </p>
        </div>
        <div class="boundary-item">
          <h3>Data</h3>
          <p>
            Selected code and task context may be sent to your model provider. Triss has no
            developer telemetry. <a href="/security/">Security and data flows</a>
          </p>
        </div>
        <div class="boundary-item">
          <h3>Execution</h3>
          <p>
            A Git worktree separates changes. It is not an operating-system sandbox.
            <a href="/coder/">Coding engines and isolation</a>
          </p>
        </div>
        <div class="boundary-item">
          <h3>Acceptance</h3>
          <p>
            A completed run is not proof that a task is correct. Review the result before using
            it. <a href="/workflows/implementation/">Implementation workflow</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Cost -->
    <section class="page-section" style="border-top: 1px solid var(--color-border); background: #0d0f13;">
      <p class="page-section__label">05 — cost</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">
        Cost is one part of the decision.
      </h2>
      <p style="margin: 18px 0 0; max-width: 46em; font-size: 16.5px; line-height: 1.65; color: var(--color-text-secondary);">
        Delegating to a lower-cost model can reduce inference spend. The result depends on the
        task, selected model, cache usage, and any retries. Compare the assumptions, not just
        the headline.
      </p>
      <p style="margin: 24px 0 0;">
        <a class="btn-secondary" href="/cost/">Explore costs and methodology</a>
      </p>
    </section>

    <!-- Commands -->
    <section id="commands" class="page-section" style="border-top: 1px solid var(--color-border);">
      <p class="page-section__label">06 — commands</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">
        The command reference
      </h2>
      <p style="margin: 18px 0 0; max-width: 46em; font-size: 16.5px; line-height: 1.65; color: var(--color-text-secondary);">
        Every CLI command and MCP tool with its options, examples, and limits — searchable, in
        one place.
      </p>
      <p style="margin: 24px 0 0;">
        <a class="btn-secondary" href="/commands/">Open the commands reference</a>
      </p>
    </section>

    <!-- Install -->
    <section id="install" class="page-section" style="border-top: 1px solid var(--color-border); background: #0d0f13;">
      <p class="page-section__label">07 — install</p>
      <h2 style="margin: 0; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">
        Install Triss
      </h2>
      <p style="margin: 18px 0 0; max-width: 46em; font-size: 16.5px; line-height: 1.65; color: var(--color-text-secondary);">
        A local CLI with no developer telemetry. Requires Node ≥ 22.12 and a credential for
        your chosen provider.
      </p>
      <pre tabindex="0" class="code-block" style="max-width: 480px;"><code>npm install -g triss-coworker</code></pre>
      <div class="workflow-next">
        <a href="/docs/getting-started/">Quickstart →</a>
        <a href="/docs/">Docs →</a>
        <a href="https://github.com/ayleen/triss-coworker" rel="noopener">GitHub →</a>
        <a href="https://www.npmjs.com/package/triss-coworker" rel="noopener">npm →</a>
        <span style="color: var(--color-text-faint);">MIT license</span>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline src="/scripts/home.js" defer></script>
</Base>
