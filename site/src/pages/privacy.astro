import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const REPO = "https://github.com/ayleen/triss-coworker";
---

<Base title="Privacy — Triss" description="What Triss stores locally, what may be sent to configured providers, and which switches minimize or clear it.">
  <Header />

  <main>
    <section style="max-width: var(--layout-max); margin: 0 auto; padding: 68px var(--layout-gutter) 44px; border-bottom: 1px solid var(--color-border);">
      <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">privacy</div>
      <h1 style="margin: 0; font-size: 52px; line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--color-text-strong); max-width: 22em;">Local software, honest about what leaves your machine.</h1>
      <p style="margin: 22px 0 0; max-width: 44em; font-size: 17px; line-height: 1.65; color: var(--color-text-secondary);">
        Triss is local software, but selected code, diffs, prompts, and tracker content may be
        sent to the providers you configure when you invoke model-backed commands. The
        authoritative per-command outbound-data table lives in
        <a href={`${REPO}/blob/main/docs/data-flows.md`} rel="noopener">docs/data-flows.md</a>; the short version for
        vendor reviews is on our <a href="/security/">security and privacy page</a>.
      </p>
    </section>

    <section class="sec-trust" style="max-width: var(--layout-max); margin: 0 auto; padding: 72px var(--layout-gutter) 0;">
      <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">what stays local</div>
      <h2 style="margin: 0; font-size: 28px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Storage on your machine, and how to shrink it.</h2>
      <div class="sec-trust__grid">
        <div class="sec-trust__item">
          <div class="sec-trust__q">Configuration and state</div>
          <p class="sec-trust__a">Triss stores your provider configuration, session and result state for delegated work, update receipts, and cache metadata — on your machine, in your home directory.</p>
        </div>
        <div class="sec-trust__item">
          <div class="sec-trust__q">Usage log</div>
          <p class="sec-trust__a">The usage log contains counters and an optional working-directory path — not prompt or file content. Set <code style="font-family: var(--font-mono);">TRISS_USAGE_LOG_CWD=0</code> or <code style="font-family: var(--font-mono);">TRISS_USAGE_LOG=0</code> to narrow it, or run <code style="font-family: var(--font-mono);">triss usage --reset</code> to clear it.</p>
        </div>
        <div class="sec-trust__item">
          <div class="sec-trust__q">No telemetry</div>
          <p class="sec-trust__a">There is no developer telemetry and no account. The one automatic network path is a credential-free passive update check, which <code style="font-family: var(--font-mono);">TRISS_UPDATE_CHECK=0</code> disables.</p>
        </div>
        <div class="sec-trust__item">
          <div class="sec-trust__q">Providers and child engines</div>
          <p class="sec-trust__a">Child coding engines see the task and context supplied to them and can modify the authorized worktree. Provider retention, training, residency, and staff access are governed by your agreement with that provider — not by Triss.</p>
        </div>
      </div>
      <p class="sec-trust__caveat">
        This website is static: it sets no cookies and includes no analytics or tracking scripts.
        The <code style="font-family: var(--font-mono);">triss coder</code> cleanup commands that remove session and
        result state are described by <code style="font-family: var(--font-mono);">triss coder --help</code>. See
        also <a class="sec-trust__link" href={`${REPO}/blob/main/PRIVACY.md`} rel="noopener">PRIVACY.md</a> in the repository.
      </p>
    </section>
  </main>

  <Footer />

  <style>
    .sec-trust__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 28px; }
    .sec-trust__item { background: var(--color-bg-raised); padding: 20px 22px; min-width: 0; }
    .sec-trust__q { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
    .sec-trust__a { margin: 8px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--color-text-secondary); }
    .sec-trust__link { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.16em; }
    .sec-trust__caveat { margin: 22px 0 0; font-size: 13px; line-height: 1.65; color: var(--color-text-muted); max-width: 72ch; }
    @media (max-width: 760px) {
      .sec-trust__grid { grid-template-columns: 1fr; }
    }
  </style>
</Base>
