import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Security & privacy — Triss" description="Triss sits between an agent, your filesystem, and your credentials. The trust boundary spelled out plainly.">
  <Header current="security" />

  <main>
  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 68px var(--layout-gutter) 44px; border-bottom: 1px solid var(--color-border);">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">security & privacy</div>
    <h1 style="margin: 0; font-size: 52px; line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--color-text-strong); max-width: 22em;">Triss sits between an agent, your filesystem, and your credentials.</h1>
    <p style="margin: 22px 0 0; max-width: 44em; font-size: 17px; line-height: 1.65; color: var(--color-text-secondary);">This page is the short version for a vendor security review. <a href="https://github.com/ayleen/triss-coworker/blob/main/SECURITY.md" style="text-decoration: underline; text-underline-offset: 0.16em;">SECURITY.md</a> is the normative document.</p>
    <div style="display: grid; grid-template-columns: repeat(4, auto); gap: 34px; margin-top: 38px; padding-top: 26px; border-top: 1px solid var(--color-border); justify-content: start;">
      <div><div style="font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--color-accent);">no telemetry</div><div style="font-size: 12.5px; color: var(--color-text-faint); margin-top: 5px;">zero data to the developers</div></div>
      <div><div style="font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--color-accent);">local-first</div><div style="font-size: 12.5px; color: var(--color-text-faint); margin-top: 5px;">CLI, not hosted service</div></div>
      <div><div style="font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--color-accent);">7 deps</div><div style="font-size: 12.5px; color: var(--color-text-faint); margin-top: 5px;">plain ESM, no build</div></div>
      <div><div style="font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--color-accent);">signed releases</div><div style="font-size: 12.5px; color: var(--color-text-faint); margin-top: 5px;">GPG tags + npm provenance</div></div>
      <div><div style="font-family: var(--font-mono); font-size: 15px; font-weight: 600; color: var(--color-accent);">MIT</div><div style="font-size: 12.5px; color: var(--color-text-faint); margin-top: 5px;">auditable on GitHub</div></div>
    </div>
  </section>

  <section class="sec-trust" style="max-width: var(--layout-max); margin: 0 auto; padding: 72px var(--layout-gutter) 0;">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">00 — the trust boundary</div>
    <h2 style="margin: 0; font-size: 28px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Four answers before the details.</h2>
    <div class="sec-trust__grid">
      <div class="sec-trust__item">
        <div class="sec-trust__q">Where does my code go?</div>
        <p class="sec-trust__a">Selected code and task context may be sent to the model provider you selected, when you invoke a model-backed command. Repository content can leave your machine — this is not a "never leaves your machine" product.</p>
      </div>
      <div class="sec-trust__item">
        <div class="sec-trust__q">Does Triss phone home?</div>
        <p class="sec-trust__a">The local CLI has no developer telemetry. The one automatic network path is a credential-free passive update check, which you can disable.</p>
      </div>
      <div class="sec-trust__item">
        <div class="sec-trust__q">Is a worktree a sandbox?</div>
        <p class="sec-trust__a">No. A Git worktree separates delegated changes from your checkout; it is not confinement of the host filesystem, and it does not block absolute-path or same-UID access.</p>
      </div>
      <div class="sec-trust__item">
        <div class="sec-trust__q">Does a successful run mean correct work?</div>
        <p class="sec-trust__a">No. A completed process is not acceptance. Inspect the changes and run the project's checks yourself before using the result.</p>
      </div>
    </div>
    <p class="sec-trust__caveat">Once context reaches an external provider, its retention, training, residency, and access policies apply — Triss does not control external provider policy. Review yours before sending confidential code. The complete per-command table lives in <a class="sec-trust__link" href="https://github.com/ayleen/triss-coworker/blob/main/docs/data-flows.md">docs/data-flows.md</a>.</p>
  </section>

  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 88px var(--layout-gutter);">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">01 — outbound traffic</div>
    <h2 style="margin: 0; font-size: 38px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; color: var(--color-text-strong);">Three default destinations — plus any URL you ask Triss to fetch.</h2>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 36px;">
      <div style="background: var(--color-bg-raised); padding: 24px; display: flex; flex-direction: column; gap: 12px;">
        <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint);">you configure it</div>
        <div style="font-size: 17px; font-weight: 600; color: var(--color-text-heading); letter-spacing: -0.02em;">The model endpoint</div>
        <p style="margin: 0; font-size: 14px; line-height: 1.65; color: var(--color-text-secondary);">Prompts and the selected corpus go to the OpenAI-compatible endpoint you set.</p>
        <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">TRISS_DEFAULT_PROVIDER + provider endpoint field</div>
      </div>
      <div style="background: var(--color-bg-raised); padding: 24px; display: flex; flex-direction: column; gap: 12px;">
        <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint);">you configure it</div>
        <div style="font-size: 17px; font-weight: 600; color: var(--color-text-heading); letter-spacing: -0.02em;">Your trackers</div>
        <p style="margin: 0; font-size: 14px; line-height: 1.65; color: var(--color-text-secondary);">Tracker commands talk to the Jira/Linear/GitHub instance you configured — only when a credential exists.</p>
        <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">per-integration env vars</div>
      </div>
      <div style="background: var(--color-bg-raised); padding: 24px; display: flex; flex-direction: column; gap: 12px;">
        <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint);">carries nothing</div>
        <div style="font-size: 17px; font-weight: 600; color: var(--color-text-heading); letter-spacing: -0.02em;">Update discovery</div>
        <p style="margin: 0; font-size: 14px; line-height: 1.65; color: var(--color-text-secondary);">A credential-free GET to a fixed public Release endpoint when the cache is due.</p>
        <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);">TRISS_UPDATE_CHECK=0</div>
      </div>
    </div>

    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 32px;">
      <button data-topic="filesystem" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: var(--color-bg-raised); color: var(--color-accent); border: 1px solid var(--color-border-strong);">filesystem</button>
      <button data-topic="network" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">url fetching</button>
      <button data-topic="credentials" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">credentials</button>
      <button data-topic="coder" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">coder / OMP</button>
      <button data-topic="log" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">usage log</button>
      <button data-topic="updates" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">updates</button>
      <button data-topic="supply" class="topic-btn" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px 16px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">supply chain</button>
    </div>
    <div id="topic-panel" style="margin-top: 20px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 24px;"></div>
  </section>

  </main>

  <Footer />

  <script is:inline src="/scripts/security-topics.js" defer></script>

  <style>
    .sec-trust__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 28px; }
    .sec-trust__item { background: var(--color-bg-raised); padding: 20px 22px; min-width: 0; }
    .sec-trust__q { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
    .sec-trust__a { margin: 8px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--color-text-secondary); }
    .sec-trust__caveat { margin: 22px 0 0; font-size: 13px; line-height: 1.65; color: var(--color-text-muted); max-width: 72ch; }
    .sec-trust__link { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.16em; }
    @media (max-width: 760px) {
      .sec-trust__grid { grid-template-columns: 1fr; }
    }
  </style>
</Base>
