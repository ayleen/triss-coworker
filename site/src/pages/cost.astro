import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ANTHROPIC, DEEPSEEK, DEFAULTS, PROFILE, calcMonthly } from "../data/pricing.js";
const _costDefaults = { ...DEFAULTS, primary: "mid" };
// Map cost page primary "mid" -> pricing "sonnet" (mid is Sonnet 4), "top" -> opus
const _costPrimaryMap: Record<string, string> = { mid: "sonnet", top: "opus" };
const _costCalc = calcMonthly({ ..._costDefaults, primary: _costPrimaryMap[_costDefaults.primary] });
function _costMoney(v: number) { return v >= 1000 ? "$" + Math.round(v).toLocaleString("en-US") : v >= 100 ? "$" + v.toFixed(0) : "$" + v.toFixed(2); }
const _costWithout = _costMoney(_costCalc.without);
const _costWith = _costMoney(_costCalc.withTriss);
const _costSaved = _costMoney(_costCalc.saved);
const _costPct = Math.round((_costCalc.saved / _costCalc.without) * 100);
const _costAnnual = _costMoney(_costCalc.saved * 12);
---

<Base title="Inference costs and methodology — Triss" description="Explore a measured Triss usage example and an API-cost calculator with explicit pricing and workload assumptions.">
  <Header current="cost" />

  <main>
  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 68px var(--layout-gutter) 40px;">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-label); margin-bottom: 18px;">inference costs & methodology</div>
    <h1 style="margin: 0; font-size: 52px; line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--color-text-strong); max-width: 22em;">The arithmetic, with the awkward parts left in.</h1>
    <p style="margin: 22px 0 0; max-width: 44em; font-size: 17px; line-height: 1.65; color: var(--color-text-secondary);">
      Every number on this page is either a published list price or a measurement from one real week on the Triss codebase. Where Triss does not pay off, that is on the page too.
    </p>
  </section>

  <section style="max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-gutter) 88px;">
    <div class="cost-applicability">
      <p class="cost-applicability__line">This estimates API inference costs for the stated workload and pricing assumptions. It does not predict a reduction in a fixed-price Claude or Codex subscription.</p>
      <p class="cost-applicability__detail">The calculator compares an Anthropic list-price baseline (Sonnet/Opus per-token prices) with DeepSeek delegated pricing at the stated cache-hit and workload assumptions — it does not price an arbitrary user-selected provider. Triss is open-source software, not a hosted subscription. Model providers and execution services may charge separately.</p>
      <p class="cost-applicability__detail">Unknown prices stay unknown: usage accounting never treats an unreported price or token count as zero — see the <a class="source-link" href="https://github.com/ayleen/triss-coworker/blob/main/docs/usage-accounting.md">usage accounting methodology</a>.</p>
    </div>
    <div style="border: 1px solid var(--color-border-strong); background: var(--color-bg-raised);">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 22px; border-bottom: 1px solid var(--color-border-subtle); flex-wrap: wrap;">
        <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint);">estimate your own bill</span>
        <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-text-label);" id="profile-label">token profile: 28K in / 4.7K out per request</span>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0;">
        <div style="padding: 28px; display: flex; flex-direction: column; gap: 26px; border-right: 1px solid var(--color-border-subtle);">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 11px;">
              <label for="c-reqs-slider" style="font-size: 14px; color: var(--color-text-secondary);">Agent requests per day</label>
              <span id="c-reqs" style="font-family: var(--font-mono); font-size: 14px; color: var(--color-text-heading);">40</span>
            </div>
            <input id="c-reqs-slider" type="range" min="10" max="400" step="10" value="40" style="width: 100%;" aria-label="Agent requests per day" />
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 11px;">
              <label for="c-share-slider" style="font-size: 14px; color: var(--color-text-secondary);">Share delegated to Triss</label>
              <span id="c-share" style="font-family: var(--font-mono); font-size: 14px; color: var(--color-text-heading);">65%</span>
            </div>
            <input id="c-share-slider" type="range" min="0" max="90" step="5" value="65" style="width: 100%;" aria-label="Share delegated to Triss" />
            <div style="font-size: 12.5px; color: var(--color-text-label); margin-top: 9px;">Measured week ran at roughly two thirds — bulk reads, reviews, fetches, commit messages.</div>
          </div>
          <div>
            <div style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 11px;">Primary model</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <button id="c-mid" aria-pressed="true" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px; cursor: pointer; background: transparent; border: 1px solid var(--color-accent); color: var(--color-accent);">$3 / $15 per 1M</button>
              <button id="c-top" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">$5 / $25 per 1M</button>
            </div>
          </div>
          <div>
            <div style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 11px;">Delegated model class</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <button id="c-standard" aria-pressed="true" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px; cursor: pointer; background: transparent; border: 1px solid var(--color-accent); color: var(--color-accent);">standard</button>
              <button id="c-advanced" aria-pressed="false" style="font-family: var(--font-mono); font-size: 12.5px; padding: 10px; cursor: pointer; background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-muted);">advanced</button>
            </div>
            <div style="font-size: 11.5px; color: var(--color-text-label); margin-top: 6px;">DeepSeek off-peak: 01:00–04:00 and 06:00–10:00 UTC peak, rest off-peak 50% off — calculator uses off-peak.</div>
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 11px;">
              <label for="c-cache-slider" style="font-size: 14px; color: var(--color-text-secondary);">Cache hit rate</label>
              <span id="c-cache" style="font-family: var(--font-mono); font-size: 14px; color: var(--color-text-heading);">77%</span>
            </div>
            <input id="c-cache-slider" type="range" min="0" max="99" step="1" value="77" style="width: 100%;" aria-label="Cache hit rate" />
            <div style="font-size: 11.5px; color: var(--color-text-label); margin-top: 6px;">average 90–95% now, week 18.5% overall (28.9% on the advanced model)</div>
          </div>
        </div>
        <div style="padding: 28px; background: #08090b; display: flex; flex-direction: column; gap: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 13px; color: var(--color-text-faint);">Agent alone</span>
            <span id="c-without" style="font-family: var(--font-mono); font-size: 18px; color: var(--color-danger); text-decoration: line-through; text-decoration-color: var(--color-danger-strike);">{_costWithout}</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 13px; color: var(--color-text-code);">Agent + Triss</span>
            <span id="c-with" style="font-family: var(--font-mono); font-size: 32px; font-weight: 600; color: var(--color-accent); letter-spacing: -0.02em;">{_costWith}</span>
          </div>
          <div id="c-saved" style="background: var(--color-accent-selection-bg); border: 1px solid var(--color-accent-selection-border); padding: 11px 13px; font-family: var(--font-mono); font-size: 12.5px; color: var(--color-accent);">saves {_costSaved} / month · {_costPct}% less</div>
          <div style="font-family: var(--font-mono); font-size: 11px; color: var(--color-text-label);">annual <span id="c-annual" style="color: var(--color-accent);">{_costAnnual}</span> saved</div>
          <div id="c-breakdown" style="border-top: 1px solid var(--color-border-subtle); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 12.5px;"></div>
        </div>
      </div>
    </div>

    <!-- Measured week -->
    <div style="margin-top: 48px; border: 1px solid var(--color-border); background: var(--color-bg-raised); padding: 24px;">
      <h2 style="margin: 0; font-size: 18px; color: var(--color-text-heading);">One measured week — not a projection</h2>
      <p style="margin: 8px 0 0; color: var(--color-text-secondary); font-size: 13.5px;">209 calls on the Triss codebase itself. A lower-cost model handled bulk reads; a higher-capability model handled reviews. The $2.22 total is the recorded cost of that one usage period — not proof of general savings or quality for every task.</p>
      <div class="cost-table cost-table--measured" style="display: grid; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 18px; font-family: var(--font-mono); font-size: 12.5px;">
        <div style="background: var(--color-bg); padding: 10px; color: var(--color-text-label);">metric</div>
        <div style="background: var(--color-bg); padding: 10px; color: var(--color-text-label); text-align: right;">advanced</div>
        <div style="background: var(--color-bg); padding: 10px; color: var(--color-text-label); text-align: right;">standard</div>
        <div style="background: var(--color-bg); padding: 10px; color: var(--color-text-label); text-align: right;">total</div>
        <div style="background: #0f1114; padding: 10px; color: var(--color-text);">Requests</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">143</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">66</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">209</div>
        <div style="background: #0f1114; padding: 10px; color: var(--color-text);">Input tokens</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">3.74M</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">2.10M</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">5.84M</div>
        <div style="background: #0f1114; padding: 10px; color: var(--color-text-muted);">↳ cache read</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-accent);">1.08M</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text-faint);">256</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-accent);">1.08M</div>
        <div style="background: #0f1114; padding: 10px; color: var(--color-text-muted);">↳ cache write</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text-faint);">—</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text-faint);">—</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text-faint);">—</div>
        <div style="background: #0f1114; padding: 10px; color: var(--color-text);">Output tokens</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">833K</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">156K</div>
        <div style="background: #0f1114; padding: 10px; text-align: right; color: var(--color-text);">990K</div>
        <div style="background: var(--color-bg-raised); padding: 10px; color: var(--color-text-heading); font-weight: 600;">Cost (USD)</div>
        <div style="background: var(--color-bg-raised); padding: 10px; text-align: right; color: var(--color-text-heading);">$1.88</div>
        <div style="background: var(--color-bg-raised); padding: 10px; text-align: right; color: var(--color-text-heading);">$0.34</div>
        <div style="background: var(--color-bg-raised); padding: 10px; text-align: right; color: var(--color-accent);">$2.22</div>
      </div>
      <p style="margin: 14px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--color-text-muted);">
        <span style="color: var(--color-accent); font-weight: 600;">Cache read 1.08M</span> — 18.5% of input tokens were cache hits (mostly on the advanced model). Without cache the week would have cost ≈$2.69 instead of $2.22. Cache is the main lever after delegation.
      </p>

      <div style="margin-top: 32px; border: 1px solid var(--color-border); background: var(--color-bg); padding: 20px;">
        <h3 style="margin: 0; font-size: 14px; font-weight: 600; color: var(--color-text-heading); font-family: var(--font-mono);">DeepSeek pricing — off-peak USD per 1M (peak 2×) — 2026-08</h3>
        <p style="margin: 6px 0 0; font-size: 12px; color: var(--color-text-label);">Source: DeepSeek's <a class="source-link" href="https://api-docs.deepseek.com/news/news260813">official pricing notice</a> and <a class="source-link" href="https://api-docs.deepseek.com/img/v4_260813_price_en.png">price card</a>; effective 2026-08-16 16:00 UTC. CLI source: <code style="font-family: var(--font-mono); color: var(--color-text-muted);">src/usage.js DEEPSEEK_PRICING</code> — override via <code style="font-family: var(--font-mono); color: var(--color-text-muted);">TRISS_PRICE_&lt;MODEL&gt;</code>. Peak: 01:00–04:00/06:00–10:00 UTC; rest off-peak.</p>
        <div class="cost-table cost-table--pricing" style="display: grid; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); margin-top: 14px; font-family: var(--font-mono); font-size: 12px;">
          <div style="background: var(--color-bg-raised); padding: 8px; color: var(--color-text-label);">metric</div>
          <div style="background: var(--color-bg-raised); padding: 8px; color: var(--color-accent); text-align: right;">standard — $0.22 / $0.007 / $0.66</div>
          <div style="background: var(--color-bg-raised); padding: 8px; color: #e0a458; text-align: right;">advanced — $0.66 / $0.022 / $1.98</div>
          <div style="background: var(--color-bg); padding: 8px; color: var(--color-text-muted);">input uncached / 1M</div><div style="background: var(--color-bg); padding: 8px; text-align: right;">$0.22</div><div style="background: var(--color-bg); padding: 8px; text-align: right;">$0.66</div>
          <div style="background: var(--color-bg); padding: 8px; color: var(--color-text-muted);">cache read / 1M</div><div style="background: var(--color-bg); padding: 8px; text-align: right; color: var(--color-accent);">$0.007</div><div style="background: var(--color-bg); padding: 8px; text-align: right; color: var(--color-accent);" title="0.022">$0.022</div>
          <div style="background: var(--color-bg); padding: 8px; color: var(--color-text-muted);">output / 1M</div><div style="background: var(--color-bg); padding: 8px; text-align: right;">$0.66</div><div style="background: var(--color-bg); padding: 8px; text-align: right;">$1.98</div>
        </div>
        <p style="margin: 10px 0 0; font-size: 11.5px; color: var(--color-text-label);">Calculator is honest: <code style="font-family: var(--font-mono); color: var(--color-text-muted);">providerCost = IN*(1-hit)*inputPrice + IN*hit*cachePrice + OUT*outputPrice</code> — previously cache was ignored and averaged as $0.0052/$0.0131. <span style="color: var(--color-text-muted);">Cache write for DeepSeek = $0.</span></p>
      </div>
      <div style="margin-top: 16px; display: flex; gap: 12px; font-size: 12.5px; flex-wrap: wrap;">
        <span style="background: var(--color-bg-code); border: 1px solid var(--color-border-strong); padding: 6px 10px; font-family: var(--font-mono);">Provider avg $0.0106/call measured</span>
        <span style="background: var(--color-accent); color: #0b0d10; padding: 6px 10px; font-family: var(--font-mono);">DeepSeek standard off-peak $0.22/$0.007/$0.66 per 1M (peak $0.44/$0.014/$1.32)</span>
      </div>
    </div>

    <!-- Where not worth -->
    <div style="margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border);">
      <div style="background: var(--color-bg-raised); padding: 20px;">
        <div style="font-size: 14px; font-weight: 600; color: var(--color-text-heading);">Tiny lookups</div>
        <p style="margin: 8px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--color-text-secondary);">A two-file read roughly breaks even: the round trip plus the summary costs about what doing it directly would.</p>
      </div>
      <div style="background: var(--color-bg-raised); padding: 20px;">
        <div style="font-size: 14px; font-weight: 600; color: var(--color-text-heading);">Judgement calls</div>
        <p style="margin: 8px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--color-text-secondary);">Architecture decisions, ambiguous requirements — being wrong is expensive. Cheap models are for volume, not verdicts.</p>
      </div>
    </div>
  </section>

  </main>

  <Footer />

  <style>
    .cost-applicability { border: 1px solid var(--color-accent-selection-border); background: var(--color-accent-selection-bg); padding: 16px 20px; margin-bottom: 24px; }
    .cost-applicability__line { margin: 0; font-size: 14px; line-height: 1.6; color: var(--color-accent); font-weight: 600; }
    .cost-applicability__detail { margin: 8px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--color-text-secondary); }
    .cost-table--measured { grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 0.8fr)); }
    .cost-table--pricing { grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); }
    .cost-table > * { min-width: 0; overflow-wrap: anywhere; }
    .source-link { text-decoration: underline; text-underline-offset: 2px; }
    @media (max-width: 480px) {
      .cost-table > * { padding-left: 6px !important; padding-right: 6px !important; }
    }
  </style>

  <script type="application/json" id="pricing-data" set:html={JSON.stringify({ profile: PROFILE, anthropic: ANTHROPIC, deepseek: DEEPSEEK, defaults: DEFAULTS })}></script>
  <script is:inline src="/scripts/pricing-cost.js" defer></script>
</Base>
