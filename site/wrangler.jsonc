{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triss",
  "main": "./src/worker/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // Documents (HTML pages), /api/*, /sitemap.xml and unknown paths invoke
    // the worker: it adds markdown content negotiation, markdown 404s, and
    // JSON /api error handling on top of the static assets. Pure asset
    // classes are negated and served straight from the asset store — they
    // need no negotiation, and every bypassed request is a worker invocation
    // saved. site/test/worker-contract.test.js keeps these patterns in sync
    // with the actual dist inventory.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/*.css",
      "!/*.js",
      "!/*.mjs",
      "!/*.map",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.gif",
      "!/*.svg",
      "!/*.webp",
      "!/*.ico",
      "!/*.woff",
      "!/*.woff2",
      "!/*.ttf",
      "!/*.otf",
      "!/*.webmanifest",
      "!/*.txt",
      "!/*.md"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
