# Triss Coworker — environment configuration reference
#
# You normally do NOT need to edit this file by hand.
# Run `triss config wizard` for an interactive masked prompt that writes
# to ~/.config/triss/.env (global) or ./.triss.env (project-local).
#
# This file documents every variable Triss recognises so you can set them
# manually if you prefer (or in CI via process.env, which always wins).

# Required: your DeepSeek API key (get one at https://platform.deepseek.com/)
TRISS_WORKER_API_KEY=

# Optional: override the API base URL (defaults to https://api.deepseek.com/v1)
# TRISS_WORKER_BASE_URL=https://api.deepseek.com/v1
# The same worker key/base/models can drive the OpenCode coder engine with:
# `triss coder init --provider worker` → `triss-worker/<model-id>`.

# Optional: override default model presets
# By default Triss uses two presets: "flash" (cheap, for bulk reads) and
# "pro" (smarter, for harder analysis). If DeepSeek renames models or you
# want to point at a different provider, override the names here.
# TRISS_WORKER_FLASH_MODEL=deepseek-v4-flash
# TRISS_WORKER_PRO_MODEL=deepseek-v4-pro

# Optional: which preset to use when no --model flag is passed (flash | pro)
# TRISS_DEFAULT_MODEL=flash

# ────────── Integrations (optional) ──────────
# Jira / Confluence (Atlassian Cloud)
# https://id.atlassian.com/manage-profile/security/api-tokens
# ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=ATATT...

# Linear
# https://linear.app/settings/api
# LINEAR_API_KEY=lin_api_...
# LINEAR_API_URL=https://api.linear.app/graphql   # override only if needed

# GitHub Issues
# https://github.com/settings/tokens (scope: repo or public_repo)
# Triss falls back to `gh auth token` automatically if this is unset.
# GITHUB_TOKEN=ghp_...

# GitLab Issues
# https://gitlab.com/-/profile/personal_access_tokens (scope: api)
# GITLAB_TOKEN=glpat-...
# GITLAB_URL=https://gitlab.com   # override for self-hosted instances

# Z.AI GLM key for `triss ask` / `triss review --provider glm` and the
# coder (default opencode V1 engine; opencode2 beta and crush optional). Use
# it with either the
# `zai-coding-plan/*` subscription endpoint or `zai/*` pay-as-you-go endpoint.
# The key does not say which plan it belongs to: with no prefix and no
# TRISS_CODER_MODEL below, ask/review try the subscription endpoint and
# auto-correct once to pay-as-you-go if it is rejected. Set TRISS_CODER_MODEL
# to pin it (that also picks the endpoint's flash/pro preset models).
# Setup for coder: `triss coder init`. Both engines share this one Z.AI key —
# crush ≥0.1.1 reads ZHIPU_API_KEY natively; triss also forwards it as
# ZAI_API_KEY for older crush binaries.
# Z.AI API key: https://z.ai/manage-apikey/apikey-list
# ZHIPU_API_KEY=

# Optional (opencode engines only): OpenCode workspace API key. Unlocks Zen
# `opencode/*` models and, with a paid Go subscription, `opencode-go/*` models.
# Zen ids rotate; discover the authenticated provider's current catalogue with
# `triss coder models --provider opencode-zen|opencode-go`.
# Models are routed via --model / TRISS_CODER_MODEL.
# triss forwards it to the opencode/opencode2 subprocess; unset it and coder
# stays on Z.AI.
# Zen docs: https://opencode.ai/docs/zen/
# Go docs: https://opencode.ai/docs/go/
# OPENCODE_API_KEY=

# Moonshot AI (Kimi) key for `triss ask` / `triss review --provider kimi`
# (ask/review presets: flash=kimi-k2.6, pro=kimi-k3) and for coder
# `moonshotai/*` models (pay-as-you-go; coder has its own defaults —
# main kimi-k2.7-code, small kimi-k2.6). One OpenAI-compatible
# endpoint, so unlike Z.AI there is no plan auto-detection to worry about.
# Key console: https://platform.kimi.ai/console/api-keys
# MOONSHOT_API_KEY=

# Optional: point `--provider kimi` at a different Moonshot endpoint —
# e.g. the China-mainland API. Default: https://api.moonshot.ai/v1
# TRISS_KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional (opencode engine only): Kimi for Coding subscription key. Unlocks
# `kimi-for-coding/*` models (e.g. kimi-for-coding/k3) — flat plan quota
# instead of per-token billing. The subscription endpoint speaks the Anthropic
# protocol, so it works for coder runs but NOT for ask/review.
# Docs: https://www.kimi.com/code/docs/en/
# KIMI_API_KEY=

# Optional: override the models written into opencode.json / passed per run.
# Z.AI GLM (default):
# TRISS_CODER_MODEL=zai-coding-plan/glm-5.2
# TRISS_CODER_SMALL_MODEL=zai-coding-plan/glm-5-turbo
# OpenCode Zen (needs OPENCODE_API_KEY; free ids rotate — verify with
# `triss coder models` and use a current id, not a stale one):
# TRISS_CODER_MODEL=opencode/deepseek-v4-flash-free
# TRISS_CODER_SMALL_MODEL=opencode/deepseek-v4-flash-free
# OpenCode Go subscription (needs OPENCODE_API_KEY and Go entitlement):
# TRISS_CODER_MODEL=opencode-go/deepseek-v4-flash
# TRISS_CODER_SMALL_MODEL=opencode-go/deepseek-v4-flash
# Existing OpenAI-compatible worker profile (needs TRISS_WORKER_API_KEY):
# TRISS_CODER_MODEL=triss-worker/deepseek-v4-flash
# TRISS_CODER_SMALL_MODEL=triss-worker/deepseek-v4-flash
# Moonshot Kimi pay-as-you-go (needs MOONSHOT_API_KEY):
# TRISS_CODER_MODEL=moonshotai/kimi-k2.7-code
# TRISS_CODER_SMALL_MODEL=moonshotai/kimi-k2.6
# Kimi for Coding subscription (needs KIMI_API_KEY):
# TRISS_CODER_MODEL=kimi-for-coding/k3
# TRISS_CODER_SMALL_MODEL=kimi-for-coding/kimi-for-coding-highspeed

# Optional: pin a different opencode-ai npm version than triss's default (1.18.7)
# TRISS_CODER_OPENCODE_VERSION=1.18.7

# Optional: pin the OpenCode 2 beta engine to a different @opencode-ai/cli
# build than triss's exact pin — the pin is an EXACT match (beta builds are
# not semver), so only change it for a verified build
# TRISS_CODER_OPENCODE2_VERSION=0.0.0-next-17430

# Optional: coding engine — opencode (default), opencode2 (beta), or crush
# TRISS_CODER_ENGINE=opencode

# Optional: pin a different @phpcraftdream/crush npm version (crush engine only)
# TRISS_CODER_CRUSH_VERSION=0.1.6

# Optional: crush only — opt INTO the CLI allowlist (--restrict-run + the
# --allow-bash/--allow-tool flags, the only enforcement path that works today
# — crush 0.1.3 ignores the permissions.run config block). Unset (the default)
# leaves crush unrestricted; crush then defaults to isolate-ON so the
# disposable worktree is the safety layer. The CLI flags --restrict /
# --no-restrict override this; crush.json permissions.run.restrict is the next
# fallback (forward-compat — currently inert).
# TRISS_CODER_CRUSH_RESTRICT=1

# ────────── Tunables (optional) ──────────

# Per-request HTTP timeout for integration calls (Jira/GitHub/GitLab/
# Linear/Confluence). Default: 30000 ms. Hits both connect and body-read.
# TRISS_HTTP_TIMEOUT_MS=30000

# Timeout for OpenAI-compatible model clients (worker, GLM, Kimi). The SDK
# default is 600000 ms. Set an integer from 1 through 2147483647 for long
# buffered ask/chat/review calls; other values retain the SDK default. 1800000
# is a 30-minute example for a long-running buffered call.
# TRISS_REQUEST_TIMEOUT_MS=1800000

# Cap the size of any integration HTTP response. Default: 25 MB.
# Prevents a runaway tracker response from OOM-ing an MCP session.
# TRISS_HTTP_MAX_BYTES=26214400

# Review limits (Release B). Reloadable; contradictions fall back to the
# complete default set. Defaults shown; hard maxima in parentheses.
# TRISS_REVIEW_SINGLE_MAX_BYTES=262144      # 256 KiB (hard max 1 MiB)
# TRISS_REVIEW_SHARD_MAX_BYTES=98304        # 96 KiB (hard max 256 KiB)
# TRISS_REVIEW_TOTAL_MAX_BYTES=4194304      # 4 MiB (hard max 16 MiB)
# TRISS_REVIEW_MAX_SHARDS=64                # (hard max 256)

# Per-file cap when `triss ask --paths` reads local files. Default: 1 MB.
# Files larger than this are reported as `<file error="too large…" />`
# instead of being loaded.
# TRISS_FILE_MAX_BYTES=1048576

# Total cap across all files in one `triss ask` corpus. Default: 16 MB.
# When hit, remaining files are skipped with a marker so the model sees
# the corpus is truncated.
# TRISS_CORPUS_MAX_BYTES=16777216

# Cap on how many files a single glob (`src/**/*.ts`) may expand to.
# Default: 500. The remainder is silently dropped with a stderr note.
# TRISS_GLOB_MAX_FILES=500

# Pin the project root used by the path sandbox and for resolving
# `./.triss.env`. `triss mcp install --local` writes this into the MCP
# launcher config automatically (the file lives in the project tree, so
# pinning is appropriate). Global installs do NOT pin it — the sandbox
# instead follows the per-session cwd that the host (Claude Code, Codex)
# sets when spawning the MCP child. Set this manually only when:
#   1) you run `triss mcp serve` directly (e.g. for debugging), or
#   2) you want to override the per-session cwd to a fixed directory
#      across all Claude Code / Codex sessions on this machine.
# TRISS_PROJECT_ROOT=/Users/me/projects/triss

# Disable the cumulative usage tracker (~/.cache/triss/usage.jsonl).
# Default: tracking is on. Set to "0" to opt out.
# TRISS_USAGE_LOG=0

# Omit the absolute working-directory path from each usage record.
# Default: cwd is logged so `triss usage --by-project` works. Set to
# "0" if you sync the log across machines or prefer not to record
# project paths. Without cwd, --by-project groups under "(unknown)".
# TRISS_USAGE_LOG_CWD=0

# Rotate the usage log when it grows past this many bytes. Default 40 MiB.
# Rotation renames the active file to usage.jsonl.old (single archive), and
# reports read only the active file. The default rose from 10 MiB with the
# v2 record schema, whose richer per-token-class detail makes a record about
# 3.7x larger, so the same setting keeps a comparable call horizon.
# TRISS_USAGE_LOG_MAX_BYTES=41943040

# Tag every usage record from this process with a parent_call_id, so a
# host (Claude Code session, CI job, batch script, ...) can group all
# Triss invocations it spawned under one identifier. External dashboards
# can then aggregate by parent_call_id. Default: unset (parent_call_id
# is null). Useful in MCP `env` blocks or wrapper scripts.
# TRISS_PARENT_CALL_ID=my-host-session-id

# Override built-in model prices for cost calculations. Unknown prices keep
# numeric cost_usd=0 for JSONL compatibility, set cost_usd_known=false, and
# are shown by `triss usage` as "unknown", not as free.
# Format: TRISS_PRICE_<MODEL_ID>=<input_uncached>,<cache_read>,<output>
# or, to also price cache writes:
#         TRISS_PRICE_<MODEL_ID>=<input_uncached>,<cache_read>,<cache_write>,<output>
# (USD per token). The three-value form leaves the cache-write rate UNKNOWN —
# it is never assumed to equal the ordinary input rate, so a non-zero
# cache-write count makes the estimate incomplete rather than wrong.
# Useful for promo pricing or non-DeepSeek providers.
# Example — pin pro to a custom negotiated rate:
# TRISS_PRICE_DEEPSEEK_V4_PRO=2e-7,2e-9,4e-7
# PAYG GLM ships with Z.AI's list prices; override one the same way
# (`zai/glm-5.2` → `ZAI_GLM_5_2`):
# TRISS_PRICE_ZAI_GLM_5_2=...

# Cap the size of a single `triss fetch` response. Default: 10 MB.
# TRISS_FETCH_MAX_BYTES=10485760

# When triss runs as an MCP server it sandboxes file IO to the cwd
# subtree by default. The CLI is unrestricted (env unset). Operators
# can opt out the server with "0" — only do this if you trust the agent.
# TRISS_RESTRICT_PATHS=0

# Allow `triss fetch` / `triss ask --urls` to reach private/loopback/
# link-local addresses. Default: blocked (SSRF guard) — defeats agents
# that try to fetch http://169.254.169.254/, http://localhost:6379/,
# 10.x, 172.16-31.x, 192.168.x, fc00::/7, etc. Set to "1" only if you
# need to read internal docs / self-hosted services from the agent.
# TRISS_ALLOW_PRIVATE_NETWORKS=1

# Disable passive CLI/MCP update checks and notices. Explicit `triss update`
# remains enabled because it is a direct user request. Default: enabled.
# TRISS_UPDATE_CHECK=0
