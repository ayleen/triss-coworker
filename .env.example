# Triss Coworker — environment configuration reference
#
# You normally do NOT need to edit this file by hand.
# Run `triss config wizard` for an interactive masked prompt that writes
# to ~/.config/triss/.env (global) or ./.triss.env (project-local).
#
# This file documents every variable Triss recognises so you can set them
# manually if you prefer (or in CI via process.env, which always wins).

# Canonical provider runtime. A clean 0.42 install uses schema 2 directly.
TRISS_CONFIG_SCHEMA=2
TRISS_DEFAULT_PROVIDER=openai-compatible
TRISS_DEFAULT_ENGINE=direct

# OpenAI-compatible
# TRISS_OPENAI_COMPATIBLE_API_KEY=
# TRISS_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
# TRISS_OPENAI_COMPATIBLE_MODEL=deepseek-v4-pro
# TRISS_OPENAI_COMPATIBLE_SMALL_MODEL=deepseek-v4-flash

# Z.A.I
# ZHIPU_API_KEY=
# TRISS_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# TRISS_ZAI_MODEL=glm-5.2
# TRISS_ZAI_SMALL_MODEL=glm-5-turbo

# OpenCode Zen and Go share one credential but have independent profiles.
# OPENCODE_API_KEY=
# TRISS_OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# TRISS_OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
# TRISS_OPENCODE_ZEN_SMALL_MODEL=deepseek-v4-flash-free
# TRISS_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# TRISS_OPENCODE_GO_MODEL=deepseek-v4-flash
# TRISS_OPENCODE_GO_SMALL_MODEL=deepseek-v4-flash

# Moonshot pay-as-you-go
# MOONSHOT_API_KEY=
# TRISS_MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# TRISS_MOONSHOT_MODEL=kimi-k2.7-code
# TRISS_MOONSHOT_SMALL_MODEL=kimi-k2.6

# Kimi for Coding subscription
# KIMI_API_KEY=
# TRISS_KIMI_FOR_CODING_BASE_URL=https://api.kimi.com/coding/v1
# TRISS_KIMI_FOR_CODING_MODEL=k3
# TRISS_KIMI_FOR_CODING_SMALL_MODEL=kimi-for-coding-highspeed

# ────────── Integrations (optional) ──────────
# ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=ATATT...
# LINEAR_API_KEY=lin_api_...
# LINEAR_API_URL=https://api.linear.app/graphql
# GITHUB_TOKEN=ghp_...
# GITLAB_TOKEN=glpat-...
# GITLAB_URL=https://gitlab.com

# ────────── Coder engines (optional) ──────────
# TRISS_CODER_ENGINE=opencode
# TRISS_CODER_PROVIDER=                    # coding provider default; absent inherits TRISS_DEFAULT_PROVIDER
# TRISS_CODER_OPENCODE_VERSION=1.18.22
# TRISS_CODER_OPENCODE2_VERSION=0.0.0-beta-19059
# TRISS_CODER_CRUSH_VERSION=0.1.6
# TRISS_CODER_CRUSH_RESTRICT=1

# ────────── Effort and credential protection (optional) ──────────
# TRISS_DEFAULT_EFFORT=high                # effort for model tasks when a request omits one
# TRISS_CODER_EFFORT=high                  # coding effort override; absent inherits TRISS_DEFAULT_EFFORT
# Credential protection is a persisted TRI-STATE: absent (engine default;
# crush defaults to protected), "true" (parent-owned proxy), or "false"
# (explicit best-effort raw run — the string "false" is never a truthy opt-in).
# TRISS_PROTECT_CREDENTIALS=true
# TRISS_CODER_PROTECT_CREDENTIALS=false    # coding-only override of the shared tri-state

# Exact-model transport override for the direct engine (expert use; a protocol
# clarification, never a model allowlist). JSON map "provider/model" -> transport.
# TRISS_MODEL_TRANSPORTS={"opencode-go/muse-spark-1.3-contributor": "openai-responses"}

# ────────── Tunables (optional) ──────────

# Per-request HTTP timeout for integration calls (Jira/GitHub/GitLab/
# Linear/Confluence). Default: 30000 ms. Hits both connect and body-read.
# TRISS_HTTP_TIMEOUT_MS=30000

# Timeout for provider model clients. When unset,
# the OpenAI SDK's own 600000 ms default applies to non-review calls; GLM
# reviews override the unset value to 1800000 ms (30 min) per attempt. Set an
# integer from 1 through 2147483647 for long buffered ask/chat/review calls;
# other values retain the SDK default. An explicit MCP timeout_ms always wins.
# Note: raising this above 1800000 (or passing an MCP timeout_ms above it)
# means the MCP host's outer tool timeout must also be raised to 3x that value
# plus headroom, because the SDK keeps its 2 retries (3 attempts total) — the
# default Codex tool_timeout_sec = 5460 only covers the 1800s-per-attempt
# GLM review. New Codex installs always get 5460; existing configs with the
# historical tool_timeout_sec = 120 are auto-migrated to 5460 on the first
# updated `triss mcp serve` startup (restart any currently running Codex sessions once).
# An exact root-level 120 is always treated as legacy (indistinguishable from a
# deliberately custom 120) and is migrated by design; tool_timeout_sec values
# other than exactly 120 are never overwritten. Keep the
# commented example at 1800000 so uncommenting it does not shorten GLM
# reviews to 10 minutes.
# TRISS_REQUEST_TIMEOUT_MS=1800000

# Cap the size of any integration HTTP response. Default: 25 MB.
# Prevents a runaway tracker response from OOM-ing an MCP session.
# TRISS_HTTP_MAX_BYTES=26214400

# Review limits. Reloadable; contradictions fall back to the
# complete default set. Defaults shown; hard maxima in parentheses.
# TRISS_REVIEW_SINGLE_MAX_BYTES=262144      # 256 KiB (hard max 1 MiB)
# TRISS_REVIEW_SHARD_MAX_BYTES=98304        # 96 KiB (hard max 256 KiB)
# TRISS_REVIEW_TOTAL_MAX_BYTES=4194304      # 4 MiB (hard max 16 MiB)
# TRISS_REVIEW_MAX_SHARDS=64                # (hard max 256)

# Per-file cap when `triss ask --paths` reads local files. Default: 1 MB.
# Files larger than this are reported as `<file error="too large…" />`
# instead of being loaded.
# TRISS_FILE_MAX_BYTES=1048576

# Total cap across all files in one `triss ask` corpus. Default: 16 MB.
# When hit, remaining files are skipped with a marker so the model sees
# the corpus is truncated.
# TRISS_CORPUS_MAX_BYTES=16777216

# Cap on how many files a single glob (`src/**/*.ts`) may expand to.
# Default: 500. The remainder is silently dropped with a stderr note.
# TRISS_GLOB_MAX_FILES=500

# Pin the project root used by the path sandbox and for resolving
# `./.triss.env`. `triss mcp install --local` writes this into the MCP
# launcher config automatically (the file lives in the project tree, so
# pinning is appropriate). Global installs do NOT pin it — the sandbox
# instead follows the per-session cwd that the host (Claude Code, Codex)
# sets when spawning the MCP child. Set this manually only when:
#   1) you run `triss mcp serve` directly (e.g. for debugging), or
#   2) you want to override the per-session cwd to a fixed directory
#      across all Claude Code / Codex sessions on this machine.
# TRISS_PROJECT_ROOT=/Users/me/projects/triss

# Disable the cumulative usage tracker (~/.cache/triss/usage.jsonl).
# Default: tracking is on. Set to "0" to opt out.
# TRISS_USAGE_LOG=0

# Omit the absolute working-directory path from each usage record.
# Default: cwd is logged so `triss usage --by-project` works. Set to
# "0" if you sync the log across machines or prefer not to record
# project paths. Without cwd, --by-project groups under "(unknown)".
# TRISS_USAGE_LOG_CWD=0

# Tag every usage record from this process with a parent_call_id, so a
# host (Claude Code session, CI job, batch script, ...) can group all
# Triss invocations it spawned under one identifier. External dashboards
# can then aggregate by parent_call_id. Default: unset (parent_call_id
# is null). Useful in MCP `env` blocks or wrapper scripts.
# TRISS_PARENT_CALL_ID=my-host-session-id

# Override built-in model prices for cost calculations. Unknown prices keep
# numeric cost_usd=0 for JSONL compatibility, set cost_usd_known=false, and
# are shown by `triss usage` as "unknown", not as free.
# Format: TRISS_PRICE_<MODEL_ID>=<input_uncached>,<cache_read>,<output>
# or, to also price cache writes:
#         TRISS_PRICE_<MODEL_ID>=<input_uncached>,<cache_read>,<cache_write>,<output>
# (USD per token). The three-value form leaves the cache-write rate UNKNOWN —
# it is never assumed to equal the ordinary input rate, so a non-zero
# cache-write count makes the estimate incomplete rather than wrong.
# Useful for promo pricing or non-DeepSeek providers.
# Example — pin pro to a custom negotiated rate:
# TRISS_PRICE_DEEPSEEK_V4_PRO=2e-7,2e-9,4e-7
# PAYG GLM ships with Z.AI's list prices; override one the same way
# (`zai/glm-5.2` → `ZAI_GLM_5_2`):
# TRISS_PRICE_ZAI_GLM_5_2=...

# When triss runs as an MCP server it sandboxes file IO to the cwd
# subtree by default. The CLI is unrestricted (env unset). Operators
# can opt out the server with "0" — only do this if you trust the agent.
# TRISS_RESTRICT_PATHS=0

# Allow `triss fetch` / `triss ask --urls` to reach private/loopback/
# link-local addresses. Default: blocked (SSRF guard) — defeats agents
# that try to fetch http://169.254.169.254/, http://localhost:6379/,
# 10.x, 172.16-31.x, 192.168.x, fc00::/7, etc. Set to "1" only if you
# need to read internal docs / self-hosted services from the agent.
# TRISS_ALLOW_PRIVATE_NETWORKS=1

# config-defaults:start
# Set to 0 to disable passive CLI/MCP update checks and notices; explicit triss update remains available.
# TRISS_UPDATE_CHECK=0

# Rotate the active usage log to usage.jsonl.old at this size (40 MiB).
# TRISS_USAGE_LOG_MAX_BYTES=41943040

# Maximum response body for triss fetch (10 MiB).
# TRISS_FETCH_MAX_BYTES=10485760
# config-defaults:end
