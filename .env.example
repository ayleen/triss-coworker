# Triss Coworker — environment configuration reference
#
# You normally do NOT need to edit this file by hand.
# Run `triss config wizard` for an interactive masked prompt that writes
# to ~/.config/triss/.env (global) or ./.triss.env (project-local).
#
# This file documents every variable Triss recognises so you can set them
# manually if you prefer (or in CI via process.env, which always wins).

# Required: your DeepSeek API key (get one at https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Optional: override the API base URL (defaults to https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: override default model presets
# By default Triss uses two presets: "flash" (cheap, for bulk reads) and
# "pro" (smarter, for harder analysis). If DeepSeek renames models or you
# want to point at a different provider, override the names here.
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Optional: which preset to use when no --model flag is passed (flash | pro)
# TRISS_DEFAULT_MODEL=flash

# ────────── Integrations (optional) ──────────
# Jira / Confluence (Atlassian Cloud)
# https://id.atlassian.com/manage-profile/security/api-tokens
# ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=ATATT...

# Linear
# https://linear.app/settings/api
# LINEAR_API_KEY=lin_api_...
# LINEAR_API_URL=https://api.linear.app/graphql   # override only if needed
